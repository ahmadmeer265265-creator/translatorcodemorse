# Cloudflare Pages. More specific rules override earlier ones for the same header.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'self' https://www.youtube-nocookie.com; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'none'; media-src 'self' blob:; upgrade-insecure-requests
  Cache-Control: public, max-age=0, must-revalidate

/favicon-16x16.png
  Cache-Control: public, max-age=86400

/favicon-32x32.png
  Cache-Control: public, max-age=86400

/favicon-16x16-dark.png
  Cache-Control: public, max-age=86400

/favicon-32x32-dark.png
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/og-default.jpg
  Cache-Control: public, max-age=86400

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Embed widgets are iframed on other sites. More specific rules replace the
# global X-Frame-Options: DENY and frame-ancestors 'none' for these paths only.
# ALLOWALL is not a framing token, so browsers ignore X-Frame-Options here and
# follow frame-ancestors *. Every other path stays DENY / frame-ancestors 'none'.
/embed/morse-code-chart/
/embed/morse-code-chart/*
/embed/morse-code-translator/
/embed/morse-code-translator/*
  X-Frame-Options: ALLOWALL
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors *; frame-src 'self' https://www.youtube-nocookie.com; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'none'; media-src 'self' blob:; upgrade-insecure-requests
