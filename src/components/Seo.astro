---
import {
  absoluteUrl,
  OG_IMAGE_ALT,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_PATH,
  OG_IMAGE_WIDTH,
  SITE_NAME,
} from '../config/site';

interface JsonLd {
  [key: string]: unknown;
}

interface Props {
  title: string;
  description: string;
  robots?: string;
  ogType?: 'website' | 'article';
  jsonLd?: JsonLd | JsonLd[];
  canonical?: boolean;
  suffix?: boolean;
}

const {
  title,
  description,
  robots = 'index, follow',
  ogType = 'website',
  jsonLd,
  canonical = true,
  suffix = true,
} = Astro.props;

const fullTitle = !suffix || title.startsWith(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
const canonicalUrl = absoluteUrl(Astro.url.pathname);
const ogImage = absoluteUrl(OG_IMAGE_PATH);
const jsonLdMarkup = jsonLd
  ? JSON.stringify(jsonLd).replaceAll('<', '\\u003c')
  : undefined;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonicalUrl} />}
<meta name="robots" content={robots} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonicalUrl} />}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
<meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
<meta property="og:image:alt" content={OG_IMAGE_ALT} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={OG_IMAGE_ALT} />
{
  jsonLdMarkup && (
    <script type="application/ld+json" is:inline set:html={jsonLdMarkup} />
  )
}
