---
import { getCollection } from 'astro:content';
import { primaryNav } from '../config/nav';
import { FACEBOOK_URL, SITE_NAME } from '../config/site';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const links = [
  ...primaryNav,
  ...(posts.length > 0 ? [{ href: '/blog/', label: 'Blog' }] : []),
  { href: '/about/', label: 'About' },
  { href: '/privacy/', label: 'Privacy' },
  { href: '/terms/', label: 'Terms' },
  { href: '/accessibility/', label: 'Accessibility' },
  { href: '/contact/', label: 'Contact' },
];
---

<footer class="site-footer">
  <div class="mx-auto flex w-full max-w-5xl flex-col gap-3 px-4 py-6 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-muted">
      <span class="font-semibold text-ink">{SITE_NAME}</span> turns text into Morse code in your browser. Nothing you type
      is uploaded.
    </p>
    <div class="flex flex-wrap items-center gap-x-1">
      <nav class="flex flex-wrap" aria-label="Footer">
        {
          links.map((link) => (
            <a class="inline-flex min-h-11 items-center px-3 text-sm text-ink" href={link.href}>
              {link.label}
            </a>
          ))
        }
      </nav>
      <a
        class="inline-flex size-11 items-center justify-center rounded-md text-accent"
        href={FACEBOOK_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Visit our Facebook page"
      >
        <svg class="size-5" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M14 8.2h2.1V5.1H14c-2.4 0-4 1.5-4 4.1v1.6H7.8v3.1H10V21h3.2v-7.1h2.3l.5-3.1H13.2V9.5c0-.8.3-1.3.8-1.3z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</footer>
