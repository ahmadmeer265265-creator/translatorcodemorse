---
import { getCollection } from 'astro:content';
import SocialLinks from './SocialLinks.astro';
import { primaryNav } from '../config/nav';
import { CONTACT_EMAIL, SITE_NAME } from '../config/site';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const toolLinks = [
  ...primaryNav,
  ...(posts.length > 0 ? [{ href: '/blog/', label: 'Blog' }] : []),
];
const legalLinks = [
  { href: '/about/', label: 'About' },
  { href: '/privacy/', label: 'Privacy' },
  { href: '/terms/', label: 'Terms' },
  { href: '/accessibility/', label: 'Accessibility' },
  { href: '/contact/', label: 'Contact' },
];

const heading = 'mb-3 text-xs font-semibold uppercase tracking-wider text-muted';
const item = 'block min-h-11 min-w-0 py-2 text-sm leading-6 text-ink';
---

<footer class="site-footer">
  <div class="mx-auto w-full max-w-5xl px-4 py-8 sm:py-10">
    <p class="pb-6 text-sm leading-6 text-muted sm:pb-8">
      <span class="font-semibold text-ink">{SITE_NAME}</span> turns text into Morse code in your browser. Nothing you type
      is uploaded.
    </p>
    <div class="grid grid-cols-2 border-t border-line pt-6 sm:grid-cols-3 sm:pt-8">
      <nav class="min-w-0 pr-3 sm:pr-5" aria-labelledby="footer-tools-heading">
        <p id="footer-tools-heading" class={heading}>Tools</p>
        <ul class="grid">
          {
            toolLinks.map((link) => (
              <li>
                <a class={item} href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav class="min-w-0 border-l border-line pl-3 sm:pl-5" aria-labelledby="footer-legal-heading">
        <p id="footer-legal-heading" class={heading}>Legal</p>
        <ul class="grid">
          {
            legalLinks.map((link) => (
              <li>
                <a class={item} href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              class="block min-h-11 min-w-0 py-2 text-sm leading-6 break-words text-muted"
              href={`mailto:${CONTACT_EMAIL}`}
            >
              {CONTACT_EMAIL}
            </a>
          </li>
        </ul>
      </nav>
      <nav
        class="col-span-2 mt-6 border-t border-line pt-6 sm:col-span-1 sm:mt-0 sm:border-t-0 sm:pt-0 sm:pl-8"
        aria-labelledby="footer-social-heading"
      >
        <p id="footer-social-heading" class={heading}>Social</p>
        <div class="flex flex-wrap items-center">
          <SocialLinks />
        </div>
      </nav>
    </div>
  </div>
</footer>
