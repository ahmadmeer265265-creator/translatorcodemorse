---
import { getCollection } from 'astro:content';
import SocialLinks from './SocialLinks.astro';
import { primaryNav } from '../config/nav';
import { CONTACT_EMAIL, SITE_NAME } from '../config/site';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const toolLinks = [
  ...primaryNav,
  ...(posts.length > 0 ? [{ href: '/blog/', label: 'Blog' }] : []),
];
const legalLinks = [
  { href: '/about/', label: 'About' },
  { href: '/privacy/', label: 'Privacy' },
  { href: '/terms/', label: 'Terms' },
  { href: '/accessibility/', label: 'Accessibility' },
  { href: '/contact/', label: 'Contact' },
];

const heading = 'text-xs font-semibold uppercase tracking-wide text-muted';
const item = 'inline-flex min-h-11 items-center text-sm text-ink';
---

<footer class="site-footer">
  <div class="mx-auto grid w-full max-w-5xl gap-8 px-4 py-6">
    <p class="text-sm text-muted">
      <span class="font-semibold text-ink">{SITE_NAME}</span> turns text into Morse code in your browser. Nothing you type
      is uploaded.
    </p>
    <div class="grid gap-8 sm:grid-cols-3">
      <nav class="grid content-start gap-1" aria-labelledby="footer-tools-heading">
        <p id="footer-tools-heading" class={heading}>Tools</p>
        <ul class="grid">
          {
            toolLinks.map((link) => (
              <li>
                <a class={item} href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav class="grid content-start gap-1" aria-labelledby="footer-legal-heading">
        <p id="footer-legal-heading" class={heading}>Legal</p>
        <ul class="grid">
          {
            legalLinks.map((link) => (
              <li>
                <a class={item} href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a class="inline-flex min-h-11 items-center text-sm text-muted" href={`mailto:${CONTACT_EMAIL}`}>
              {CONTACT_EMAIL}
            </a>
          </li>
        </ul>
      </nav>
      <nav class="grid content-start gap-1" aria-labelledby="footer-social-heading">
        <p id="footer-social-heading" class={heading}>Social</p>
        <div class="flex flex-wrap items-center">
          <SocialLinks />
        </div>
      </nav>
    </div>
  </div>
</footer>
