---
/**
 * Typed American Morse converter, playback, and mic/file decode.
 * Article content and schema stay later stages.
 */
import {
  AUDIO_FILE_ACCEPT,
  EXTRA_LONG_DASH_LABEL,
  EXTRA_LONG_DASH_TOKEN,
  LONG_DASH_LABEL,
  LONG_DASH_TOKEN,
} from '../../lib/american-translator-ui';
import '../../styles/american-translator.css';
---

<section class="am-tool" data-american-translator aria-label="American Morse translator">
  <div class="am-card">
    <div class="am-tabs" role="radiogroup" aria-label="Input mode">
      <label class="am-tab">
        <input class="sr-only" type="radio" name="am-view" value="type" checked />
        <span>Type</span>
      </label>
      <label class="am-tab">
        <input class="sr-only" type="radio" name="am-view" value="listen" />
        <span>Listen</span>
      </label>
    </div>

    <div class="am-type">
      <div class="am-pair">
        <div class="am-col">
          <label class="am-label" for="am-text">Plain text</label>
          <textarea
            id="am-text"
            class="am-field"
            data-text
            rows="2"
            autocomplete="off"
            placeholder="Type letters, numbers, or punctuation"
          ></textarea>
          <p class="am-note" data-text-note aria-live="polite"></p>
        </div>
        <div class="am-col">
          <label class="am-label" for="am-morse">American Morse</label>
          <textarea
            id="am-morse"
            class="am-field am-field--mono"
            data-morse
            rows="2"
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            placeholder=".- for A, space inside C O R Y Z, / between letters, // between words"
          ></textarea>
          <div class="am-keys" role="group" aria-label="Insert a dash that is not on the keyboard">
            <button class="am-key" type="button" data-insert={LONG_DASH_TOKEN}>{LONG_DASH_LABEL}</button>
            <button class="am-key" type="button" data-insert={EXTRA_LONG_DASH_TOKEN}>{EXTRA_LONG_DASH_LABEL}</button>
          </div>
          <p class="am-note" data-morse-note aria-live="polite"></p>
        </div>
      </div>
      <p class="am-legend am-legend--note">
        <span>Space is the pause inside a letter.</span>
        <span>/ next letter. // next word.</span>
      </p>

      <div class="am-playbar">
        <div class="am-sound" role="radiogroup" aria-label="Playback sound">
          <label class="am-tab">
            <input class="sr-only" type="radio" name="am-mode" value="sounder" data-mode checked />
            <span>Telegraph sounder</span>
          </label>
          <label class="am-tab">
            <input class="sr-only" type="radio" name="am-mode" value="cw" data-mode />
            <span>CW tone</span>
          </label>
        </div>
        <div class="am-audio-row">
          <button class="am-btn am-btn--primary" type="button" data-play>Play</button>
          <button class="am-btn" type="button" data-stop>Stop</button>
          <span class="am-lamp" data-lamp data-mode="sounder" data-on="false" aria-hidden="true"></span>
          <span class="am-legend">The light follows CW tone only.</span>
        </div>
      </div>
      <p class="am-note" data-play-note aria-live="polite"></p>

      <details class="am-settings">
        <summary>Playback settings</summary>
        <div class="am-settings__body">
          <label class="am-slider" for="am-speed">
            <span>Speed</span>
            <input id="am-speed" type="range" min="5" max="40" value="15" step="1" data-speed />
          </label>
          <label class="am-slider" for="am-volume">
            <span>Volume</span>
            <input id="am-volume" type="range" min="0" max="100" value="70" step="1" data-volume />
          </label>
          <label class="am-slider" for="am-pitch" data-pitch-wrap data-disabled="true">
            <span>Pitch</span>
            <input id="am-pitch" type="range" min="200" max="1200" value="700" step="10" data-pitch disabled />
          </label>
          <label class="am-choice">
            <input type="checkbox" data-vibrate checked />
            Vibrate with the marks
          </label>
        </div>
      </details>
    </div>

    <div class="am-listen">
      <p class="am-legend">
        Listening and file decoding stay on this device. The audio is not recorded or uploaded.
      </p>
      <div class="am-audio-row">
        <button class="am-btn am-btn--primary" type="button" data-mic aria-pressed="false">Start listening</button>
      </div>
      <div
        class="am-meter"
        role="meter"
        aria-label="Microphone level"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        data-mic-meter
      >
        <div class="am-meter__bar" data-mic-bar></div>
      </div>
      <p class="am-note" data-mic-error role="alert" hidden></p>
      <button class="am-drop" type="button" data-drop>
        <span>Drop an audio file here, or click to browse</span>
        <span class="am-drop__hint">WAV, MP3, or OGG. Decoded on this device.</span>
      </button>
      <input class="am-file" type="file" accept={AUDIO_FILE_ACCEPT} data-file aria-label="Choose an audio file" />
      <p class="am-note" data-file-error role="alert" hidden></p>
      <p class="am-note" data-file-name></p>
      <p class="am-note am-mono" data-audio-morse></p>
      <label class="am-label" for="am-heard">Heard as text</label>
      <textarea id="am-heard" class="am-field" data-heard rows="2" readonly aria-live="polite"></textarea>
      <details class="am-settings">
        <summary>Listening settings</summary>
        <div class="am-settings__body">
          <label class="am-slider" for="am-sensitivity">
            <span>Microphone pickup</span>
            <input
              id="am-sensitivity"
              type="range"
              min="0"
              max="100"
              value="70"
              step="1"
              data-sensitivity
              aria-describedby="am-sensitivity-note"
            />
          </label>
          <p class="am-legend" id="am-sensitivity-note">
            Higher pickup hears quieter signals. Lower pickup ignores more room noise.
          </p>
        </div>
      </details>
    </div>
  </div>
</section>

<script>
  import { createAmericanMicDecoder } from '../../lib/american-mic-decode';
  import { decodeFilteredPcm } from '../../lib/american-file-decode';
  import {
    buildAmericanTimeline,
    clampPitch,
    clampSpeed,
    clampVolume,
    cuesFor,
    lampOn,
    pitchEnabled,
    startVibration,
    stopVibration,
    timelineDuration,
    type PlaybackMode,
    type TimedSpan,
  } from '../../lib/american-playback';
  import {
    EXTRA_LONG_DASH_TOKEN,
    LONG_DASH_TOKEN,
    convertMorse,
    convertText,
    fileErrorMessage,
    insertToken,
    isAudioFileName,
    micErrorKind,
    micErrorMessage,
    micThresholdFor,
    notationWarning,
    unsupportedWarning,
  } from '../../lib/american-translator-ui';

  const root = document.querySelector<HTMLElement>('[data-american-translator]');
  const textEl = root?.querySelector<HTMLTextAreaElement>('[data-text]');
  const morseEl = root?.querySelector<HTMLTextAreaElement>('[data-morse]');
  const textNote = root?.querySelector<HTMLElement>('[data-text-note]');
  const morseNote = root?.querySelector<HTMLElement>('[data-morse-note]');
  const heardEl = root?.querySelector<HTMLTextAreaElement>('[data-heard]');
  const micButton = root?.querySelector<HTMLButtonElement>('[data-mic]');
  const micError = root?.querySelector<HTMLElement>('[data-mic-error]');
  const meter = root?.querySelector<HTMLElement>('[data-mic-meter]');
  const meterBar = root?.querySelector<HTMLElement>('[data-mic-bar]');
  const drop = root?.querySelector<HTMLButtonElement>('[data-drop]');
  const fileInput = root?.querySelector<HTMLInputElement>('[data-file]');
  const fileError = root?.querySelector<HTMLElement>('[data-file-error]');
  const fileName = root?.querySelector<HTMLElement>('[data-file-name]');
  const audioMorse = root?.querySelector<HTMLElement>('[data-audio-morse]');
  const playButton = root?.querySelector<HTMLButtonElement>('[data-play]');
  const stopButton = root?.querySelector<HTMLButtonElement>('[data-stop]');
  const lamp = root?.querySelector<HTMLElement>('[data-lamp]');
  const speedInput = root?.querySelector<HTMLInputElement>('[data-speed]');
  const volumeInput = root?.querySelector<HTMLInputElement>('[data-volume]');
  const pitchInput = root?.querySelector<HTMLInputElement>('[data-pitch]');
  const pitchWrap = root?.querySelector<HTMLElement>('[data-pitch-wrap]');
  const vibrateInput = root?.querySelector<HTMLInputElement>('[data-vibrate]');
  const playNote = root?.querySelector<HTMLElement>('[data-play-note]');
  const sensitivityInput = root?.querySelector<HTMLInputElement>('[data-sensitivity]');
  const modeInputs = [...(root?.querySelectorAll<HTMLInputElement>('input[data-mode]') ?? [])];

  if (
    root &&
    textEl &&
    morseEl &&
    textNote &&
    morseNote &&
    heardEl &&
    micButton &&
    micError &&
    meter &&
    meterBar &&
    drop &&
    fileInput &&
    fileError &&
    fileName &&
    audioMorse &&
    playButton &&
    stopButton &&
    lamp &&
    speedInput &&
    volumeInput &&
    pitchInput &&
    pitchWrap &&
    vibrateInput &&
    playNote &&
    sensitivityInput &&
    modeInputs.length === 2
  ) {
    const showAlert = (el: HTMLElement, message: string) => {
      el.textContent = message;
      el.hidden = message.length === 0;
    };

    const syncFromText = () => {
      const result = convertText(textEl.value);
      morseEl.value = result.output;
      textNote.textContent = unsupportedWarning(result.unsupported);
      morseNote.textContent = '';
    };

    const syncFromMorse = () => {
      const result = convertMorse(morseEl.value);
      textEl.value = result.output;
      morseNote.textContent = notationWarning(morseEl.value);
      textNote.textContent = result.unknown > 0 ? `${result.unknown} Morse group${result.unknown === 1 ? '' : 's'} could not be read and became #.` : '';
    };

    textEl.addEventListener('input', syncFromText);
    morseEl.addEventListener('input', syncFromMorse);

    root.querySelectorAll<HTMLButtonElement>('[data-insert]').forEach((button) => {
      button.addEventListener('mousedown', (event) => {
        event.preventDefault();
      });
      button.addEventListener('click', () => {
        const token = button.dataset.insert === EXTRA_LONG_DASH_TOKEN ? EXTRA_LONG_DASH_TOKEN : LONG_DASH_TOKEN;
        const focused = document.activeElement === morseEl;
        const start = focused ? morseEl.selectionStart : morseEl.value.length;
        const end = focused ? morseEl.selectionEnd : morseEl.value.length;
        const next = insertToken(morseEl.value, start, end, token);
        morseEl.value = next.value;
        morseEl.focus();
        morseEl.setSelectionRange(next.cursor, next.cursor);
        syncFromMorse();
      });
    });

    const rms = (samples: Float32Array) => {
      let sum = 0;
      for (const sample of samples) sum += sample * sample;
      return Math.sqrt(sum / samples.length);
    };

    let decoder = createAmericanMicDecoder();
    let stream: MediaStream | null = null;
    let ctx: AudioContext | null = null;
    let analyser: AnalyserNode | null = null;
    let source: MediaStreamAudioSourceNode | null = null;
    let rafId = 0;
    let running = false;
    let markStart: number | null = null;
    let spaceStart: number | null = null;
    let sampleBuf: Float32Array<ArrayBuffer> | null = null;
    let stopPlayback = () => {};

    const applyHeard = (text: string, morse: string) => {
      heardEl.value = text;
      audioMorse.textContent = morse;
    };

    const setListening = (on: boolean) => {
      running = on;
      micButton.setAttribute('aria-pressed', on ? 'true' : 'false');
      micButton.textContent = on ? 'Stop listening' : 'Start listening';
    };

    const stopTracks = () => {
      stream?.getTracks().forEach((track) => track.stop());
      stream = null;
      source?.disconnect();
      source = null;
      analyser = null;
      if (ctx) void ctx.close().catch(() => {});
      ctx = null;
    };

    const stopMic = () => {
      if (rafId) cancelAnimationFrame(rafId);
      rafId = 0;
      const now = performance.now();
      if (markStart !== null) decoder.push({ type: 'mark', durationMs: now - markStart });
      if (spaceStart !== null) decoder.push({ type: 'space', durationMs: now - spaceStart });
      markStart = null;
      spaceStart = null;
      const state = decoder.flush();
      if (running || state.text) applyHeard(state.text, state.morse);
      stopTracks();
      setListening(false);
      meterBar.style.width = '0';
      meter.setAttribute('aria-valuenow', '0');
    };

    const tick = (now: number) => {
      if (!running || !analyser) return;
      if (!sampleBuf || sampleBuf.length !== analyser.fftSize) sampleBuf = new Float32Array(analyser.fftSize);
      analyser.getFloatTimeDomainData(sampleBuf);
      const level = rms(sampleBuf);
      const pct = Math.min(100, Math.round((level / 0.25) * 100));
      meterBar.style.width = `${pct}%`;
      meter.setAttribute('aria-valuenow', String(pct));
      const isMark = level >= micThresholdFor(Number(sensitivityInput.value));
      if (isMark) {
        if (spaceStart !== null) {
          decoder.push({ type: 'space', durationMs: now - spaceStart });
          spaceStart = null;
        }
        if (markStart === null) markStart = now;
      } else {
        if (markStart !== null) {
          decoder.push({ type: 'mark', durationMs: now - markStart });
          markStart = null;
        }
        if (spaceStart === null) spaceStart = now;
        else decoder.silence(now - spaceStart);
      }
      const state = decoder.snapshot();
      applyHeard(state.text, state.morse);
      rafId = requestAnimationFrame(tick);
    };

    const startMic = async () => {
      showAlert(micError, '');
      stopPlayback();
      stopMic();
      if (!navigator.mediaDevices?.getUserMedia) {
        showAlert(micError, micErrorMessage('unsupported'));
        return;
      }
      if (!window.isSecureContext) {
        showAlert(micError, micErrorMessage('insecure'));
        return;
      }
      try {
        stream = await navigator.mediaDevices.getUserMedia({
          audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: false },
        });
      } catch (error) {
        const name = error instanceof DOMException ? error.name : '';
        showAlert(micError, micErrorMessage(micErrorKind(name)));
        stream = null;
        return;
      }
      const AudioCtx =
        window.AudioContext ??
        (window as Window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
      if (!AudioCtx) {
        showAlert(micError, micErrorMessage('unsupported'));
        stopTracks();
        return;
      }
      ctx = new AudioCtx();
      await ctx.resume().catch(() => {});
      source = ctx.createMediaStreamSource(stream);
      analyser = ctx.createAnalyser();
      analyser.fftSize = 1024;
      source.connect(analyser);
      decoder = createAmericanMicDecoder();
      decoder.reset();
      applyHeard('', '');
      fileName.textContent = '';
      markStart = null;
      spaceStart = null;
      setListening(true);
      rafId = requestAnimationFrame(tick);
    };

    micButton.addEventListener('click', () => {
      if (running) stopMic();
      else void startMic();
    });

    const readFile = async (file: File) => {
      showAlert(fileError, '');
      stopPlayback();
      if (running) stopMic();
      if (!isAudioFileName(file.name)) {
        showAlert(fileError, fileErrorMessage('type', file.name));
        return;
      }
      fileName.textContent = file.name;
      const AudioCtx =
        window.AudioContext ??
        (window as Window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
      if (!AudioCtx) {
        showAlert(fileError, fileErrorMessage('decode', file.name));
        return;
      }
      const audioCtx = new AudioCtx();
      try {
        const buffer = await audioCtx.decodeAudioData(await file.arrayBuffer());
        const mono = new Float32Array(buffer.length);
        const channels = buffer.numberOfChannels;
        for (let channel = 0; channel < channels; channel += 1) {
          const data = buffer.getChannelData(channel);
          for (let i = 0; i < buffer.length; i += 1) mono[i] = (mono[i] ?? 0) + data[i]! / channels;
        }
        const state = decodeFilteredPcm(mono, buffer.sampleRate);
        applyHeard(state.text, state.morse);
        fileName.textContent = file.name;
        if (!state.text) showAlert(fileError, 'No Morse was found in that audio.');
      } catch {
        showAlert(fileError, fileErrorMessage('decode', file.name));
      } finally {
        void audioCtx.close().catch(() => {});
      }
    };

    drop.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file) void readFile(file);
      fileInput.value = '';
    });
    drop.addEventListener('dragover', (event) => {
      event.preventDefault();
      drop.dataset.dragging = 'true';
    });
    drop.addEventListener('dragleave', () => {
      delete drop.dataset.dragging;
    });
    drop.addEventListener('drop', (event) => {
      event.preventDefault();
      delete drop.dataset.dragging;
      const file = event.dataTransfer?.files?.[0];
      if (file) void readFile(file);
    });

    type PlayGraph = {
      ctx: AudioContext;
      master: GainNode;
      osc: OscillatorNode | null;
      sources: AudioBufferSourceNode[];
    };

    let graph: PlayGraph | null = null;
    let lampRaf = 0;
    let playing = false;
    let starting = false;
    let activeTimeline: TimedSpan[] = [];
    let activeMode: PlaybackMode = 'sounder';
    let playOrigin = 0;

    const vibrationSupported = typeof navigator.vibrate === 'function';
    if (!vibrationSupported) {
      vibrateInput.checked = false;
      vibrateInput.disabled = true;
      playNote.textContent = 'This device does not vibrate.';
    }

    const vibrate = (pattern: number[]) => navigator.vibrate?.(pattern) ?? false;

    const selectedMode = (): PlaybackMode => (modeInputs.some((input) => input.checked && input.value === 'cw') ? 'cw' : 'sounder');

    const syncPitchControl = () => {
      const enabled = pitchEnabled(selectedMode());
      pitchInput.disabled = !enabled;
      pitchWrap.dataset.disabled = enabled ? 'false' : 'true';
      lamp.dataset.mode = selectedMode();
    };

    const setLamp = (on: boolean) => {
      lamp.dataset.on = on ? 'true' : 'false';
    };

    const clickBuffer = (audio: AudioContext, ms: number) => {
      const length = Math.max(1, Math.round(audio.sampleRate * (ms / 1000)));
      const buffer = audio.createBuffer(1, length, audio.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < length; i += 1) {
        const env = Math.sin((Math.PI * i) / Math.max(1, length - 1));
        data[i] = (Math.random() * 2 - 1) * env * env;
      }
      return buffer;
    };

    stopPlayback = () => {
      const wasPlaying = playing || graph !== null;
      if (lampRaf) cancelAnimationFrame(lampRaf);
      lampRaf = 0;
      playing = false;
      setLamp(false);
      if (graph) {
        const { ctx, osc, sources } = graph;
        if (osc) {
          try {
            osc.stop();
          } catch {
            /* already stopped */
          }
        }
        for (const source of sources) {
          try {
            source.stop();
          } catch {
            /* already stopped */
          }
        }
        void ctx.close().catch(() => {});
        graph = null;
      }
      if (wasPlaying) stopVibration(vibrate, vibrationSupported);
    };

    const paintLamp = (now: number) => {
      if (!playing) return;
      const elapsed = now - playOrigin;
      setLamp(lampOn(activeMode, activeTimeline, elapsed));
      if (elapsed < timelineDuration(activeTimeline) + 40) lampRaf = requestAnimationFrame(paintLamp);
      else stopPlayback();
    };

    const startPlayback = async () => {
      if (starting) return;
      starting = true;
      try {
        if (running) stopMic();
        stopPlayback();
        const timeline = buildAmericanTimeline(morseEl.value, clampSpeed(Number(speedInput.value)));
        if (!timeline.some((span) => span.on)) {
          if (!vibrationSupported) playNote.textContent = 'This device does not vibrate.';
          else playNote.textContent = 'Type Morse above, then play it.';
          return;
        }
        if (vibrationSupported) playNote.textContent = '';
        const mode = selectedMode();
        const AudioCtx =
          window.AudioContext ??
          (window as Window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
        if (!AudioCtx) {
          playNote.textContent = 'This browser cannot play audio.';
          return;
        }
        const ctx = new AudioCtx();
        await ctx.resume().catch(() => {});
        const master = ctx.createGain();
        master.gain.value = clampVolume(Number(volumeInput.value)) / 100;
        master.connect(ctx.destination);
        const cues = cuesFor(mode, timeline);
        const t0 = ctx.currentTime + 0.05;
        let osc: OscillatorNode | null = null;
        const sources: AudioBufferSourceNode[] = [];
        if (mode === 'cw') {
          osc = ctx.createOscillator();
          const env = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.value = clampPitch(Number(pitchInput.value));
          env.gain.value = 0;
          osc.connect(env);
          env.connect(master);
          for (const tone of cues.tones) {
            const start = t0 + tone.startMs / 1000;
            const end = start + Math.max(0.001, tone.durationMs / 1000);
            const attack = Math.min(0.005, Math.max(0.001, (end - start) / 3));
            const hold = Math.max(start + attack, end - attack);
            env.gain.setValueAtTime(0, start);
            env.gain.linearRampToValueAtTime(1, start + attack);
            if (hold > start + attack) env.gain.setValueAtTime(1, hold);
            env.gain.linearRampToValueAtTime(0, Math.max(hold, end));
          }
          const finish = t0 + timelineDuration(timeline) / 1000 + 0.02;
          osc.start(t0);
          osc.stop(Math.max(finish, t0 + 0.03));
        } else {
          const down = clickBuffer(ctx, 8);
          const up = clickBuffer(ctx, 6);
          for (const click of cues.clicks) {
            const source = ctx.createBufferSource();
            const gain = ctx.createGain();
            source.buffer = click.edge === 'down' ? down : up;
            gain.gain.value = click.edge === 'down' ? 0.9 : 0.45;
            source.connect(gain);
            gain.connect(master);
            source.start(t0 + click.atMs / 1000);
            sources.push(source);
          }
        }
        graph = { ctx, master, osc, sources };
        activeTimeline = timeline;
        activeMode = mode;
        playing = true;
        playOrigin = performance.now() + 50;
        if (vibrateInput.checked) startVibration(timeline, vibrate, vibrationSupported);
        setLamp(false);
        lampRaf = requestAnimationFrame(paintLamp);
      } finally {
        starting = false;
      }
    };

    playButton.addEventListener('click', () => {
      void startPlayback();
    });
    stopButton.addEventListener('click', stopPlayback);
    volumeInput.addEventListener('input', () => {
      if (!graph) return;
      graph.master.gain.setValueAtTime(clampVolume(Number(volumeInput.value)) / 100, graph.ctx.currentTime);
    });
    pitchInput.addEventListener('input', () => {
      if (!graph?.osc) return;
      graph.osc.frequency.setTargetAtTime(clampPitch(Number(pitchInput.value)), graph.ctx.currentTime, 0.01);
    });
    speedInput.addEventListener('input', () => {
      if (playing) stopPlayback();
    });
    vibrateInput.addEventListener('change', () => {
      if (!vibrateInput.checked && playing) stopVibration(vibrate, vibrationSupported);
    });
    for (const input of modeInputs) {
      input.addEventListener('change', () => {
        syncPitchControl();
        if (playing) stopPlayback();
      });
    }
    syncPitchControl();

    window.addEventListener('pagehide', () => {
      stopPlayback();
      if (running) stopMic();
    });
  }
</script>
