---
import {
  MACHINE_ACTIVITY_LABEL,
  MACHINE_CHART_DIGITS,
  MACHINE_CHART_LETTERS,
  MACHINE_KEYBINDS,
  MACHINE_MODE_HINT,
} from '../../lib/morse-machine-ui';
import { DEFAULT_MACHINE_WPM, MACHINE_WPM_MAX, MACHINE_WPM_MIN } from '../../lib/morse-machine-timing';
import {
  DEFAULT_SIDETONE_PITCH,
  DEFAULT_SIDETONE_VOLUME,
  SIDETONE_PITCH_MAX,
  SIDETONE_PITCH_MIN,
} from '../../lib/morse-machine-sidetone';
import '../../styles/morse-machine.css';
---

<section class="mm-tool" data-morse-machine data-mm-theme="light" aria-label="Morse Code Machine">
  <div class="mm-card" data-card data-mode="key" data-activity="send">
    <div class="mm-tabs mm-tabs--activity" role="radiogroup" aria-label="Activity" data-activity-tabs>
      <label class="mm-tab">
        <input class="sr-only" type="radio" name="mm-activity" value="send" data-activity checked />
        <span>Send</span>
      </label>
      <label class="mm-tab">
        <input class="sr-only" type="radio" name="mm-activity" value="listen" data-activity />
        <span>{MACHINE_ACTIVITY_LABEL.listen}</span>
      </label>
      <label class="mm-tab">
        <input class="sr-only" type="radio" name="mm-activity" value="letter" data-activity />
        <span>{MACHINE_ACTIVITY_LABEL.letter}</span>
      </label>
    </div>

    <div class="mm-tabs mm-tabs--mode" role="radiogroup" aria-label="Input mode" data-input-tabs>
      <label class="mm-tab">
        <input class="sr-only" type="radio" name="mm-mode" value="key" data-mode checked />
        <span>Key</span>
      </label>
      <label class="mm-tab">
        <input class="sr-only" type="radio" name="mm-mode" value="type" data-mode />
        <span>Type</span>
      </label>
      <label class="mm-tab">
        <input class="sr-only" type="radio" name="mm-mode" value="paddle" data-mode />
        <span>Paddle</span>
      </label>
    </div>

    <div class="mm-practice" data-practice>
      <div class="mm-diff" role="radiogroup" aria-label="Difficulty">
        <label>
          <input class="sr-only" type="radio" name="mm-diff" value="character" data-diff checked />
          <span>Character</span>
        </label>
        <label>
          <input class="sr-only" type="radio" name="mm-diff" value="word" data-diff />
          <span>Word</span>
        </label>
      </div>
      <p class="mm-listen-hint" data-listen-hint>Listen, then send what you heard.</p>
      <p class="mm-target" data-target aria-live="polite"></p>
      <p class="mm-feedback" data-feedback aria-live="polite"></p>
      <div class="mm-actions">
        <button class="mm-btn" type="button" data-play>Play</button>
        <button class="mm-btn" type="button" data-replay>Play again</button>
        <button class="mm-btn" type="button" data-check>Check</button>
        <button class="mm-btn" type="button" data-next>Next</button>
      </div>
    </div>

    <div class="mm-live">
      <span class="mm-label" id="mm-morse-label">Morse</span>
      <p class="mm-out" data-morse-out aria-labelledby="mm-morse-label" aria-live="polite"></p>
      <span class="mm-label" id="mm-text-label">Decoded text</span>
      <p class="mm-out mm-out--text" data-text-out aria-labelledby="mm-text-label" aria-live="polite"></p>
      <p class="mm-hint" data-hint>{MACHINE_MODE_HINT.key}</p>
    </div>

    <div class="mm-key">
      <button
        class="mm-pad"
        type="button"
        data-pad
        data-pressed="false"
        aria-label="Morse key. Tap or hold. Short is a dot, longer is a dash. Spacebar does the same."
      >
        Tap or hold · Space
      </button>
    </div>

    <div class="mm-type">
      <label class="mm-label" for="mm-type">Type letters</label>
      <textarea
        id="mm-type"
        class="mm-type-field"
        data-type
        rows="2"
        autocomplete="off"
        autocapitalize="characters"
        spellcheck="false"
        placeholder="Type here"
      ></textarea>
    </div>

    <div class="mm-paddle">
      <div class="mm-paddles" role="group" aria-label="Iambic paddles">
        <button class="mm-paddle-btn" type="button" data-paddle="dot" data-pressed="false" aria-label="Dit paddle. Keyboard J or left arrow.">
          Dit · J / ←
        </button>
        <button class="mm-paddle-btn" type="button" data-paddle="dash" data-pressed="false" aria-label="Dah paddle. Keyboard K or right arrow.">
          Dah · K / →
        </button>
      </div>
    </div>

    <div class="mm-row">
      <button class="mm-btn" type="button" data-clear>Clear</button>
    </div>

    <details class="mm-settings" data-settings>
      <summary>Settings</summary>
      <div class="mm-settings__body">
        <label class="mm-speed" for="mm-speed">
          <span>Speed</span>
          <input
            id="mm-speed"
            type="range"
            min={MACHINE_WPM_MIN}
            max={MACHINE_WPM_MAX}
            value={DEFAULT_MACHINE_WPM}
            step="1"
            data-speed
          />
          <output id="mm-speed-value" for="mm-speed" data-speed-value>{DEFAULT_MACHINE_WPM} WPM</output>
        </label>
        <label class="mm-check" for="mm-sidetone">
          <input id="mm-sidetone" type="checkbox" data-sidetone-on checked />
          <span>Sidetone</span>
        </label>
        <label class="mm-speed" for="mm-volume">
          <span>Volume</span>
          <input
            id="mm-volume"
            type="range"
            min="0"
            max="100"
            value={DEFAULT_SIDETONE_VOLUME}
            step="1"
            data-volume
          />
          <output id="mm-volume-value" for="mm-volume" data-volume-value>{DEFAULT_SIDETONE_VOLUME}%</output>
        </label>
        <label class="mm-speed" for="mm-pitch">
          <span>Pitch</span>
          <input
            id="mm-pitch"
            type="range"
            min={SIDETONE_PITCH_MIN}
            max={SIDETONE_PITCH_MAX}
            value={DEFAULT_SIDETONE_PITCH}
            step="10"
            data-pitch
          />
          <output id="mm-pitch-value" for="mm-pitch" data-pitch-value>{DEFAULT_SIDETONE_PITCH} Hz</output>
        </label>
        <span class="mm-label">Theme</span>
        <button
          class="mm-btn mm-theme-toggle"
          type="button"
          data-mm-theme-toggle
          aria-pressed="false"
          aria-label="Switch to dark theme"
        >
          Switch to dark theme
        </button>
      </div>
    </details>

    <details class="mm-ref">
      <summary>Characters and keybinds</summary>
      <div class="mm-ref__body">
        <ul class="mm-binds">
          {MACHINE_KEYBINDS.map((row) => (
            <li>
              <strong>{row.keys}</strong>
              {' — '}
              {row.action}
            </li>
          ))}
        </ul>
        <div class="mm-chart" aria-label="Letter Morse chart">
          {MACHINE_CHART_LETTERS.map((entry) => (
            <span>
              <b>{entry.char}</b>
              <code>{entry.code}</code>
            </span>
          ))}
        </div>
        <div class="mm-chart" aria-label="Number Morse chart">
          {MACHINE_CHART_DIGITS.map((entry) => (
            <span>
              <b>{entry.char}</b>
              <code>{entry.code}</code>
            </span>
          ))}
        </div>
        <a class="mm-chart-link" href="/morse-code-alphabet/">Full Morse alphabet chart</a>
      </div>
    </details>
  </div>
</section>

<script>
  import {
    createIambicKeyer,
    DEFAULT_IAMBIC_WPM,
    type IambicKeyer,
    type IambicSide,
  } from '../../lib/iambic-keyer?mm';
  import type { MorseKeyEvent } from '../../lib/morse-key-events?mm';
  import { createStraightKeySession, clampMachineWpm } from '../../lib/morse-machine-timing?mm';
  import {
    clampSidetonePitch,
    clampSidetoneVolume,
    createSidetone,
  } from '../../lib/morse-machine-sidetone?mm';
  import {
    checkPractice,
    displayForMode,
    isMachineActivity,
    isMachineMode,
    isMachineTheme,
    isPracticeDifficulty,
    liveSidetoneAllowed,
    MACHINE_MODE_HINT,
    machineThemeToggleLabel,
    nextPracticePrompt,
    practiceFeedback,
    type ListenAndGuessPrompt,
    type MachineActivity,
    type MachineMode,
    type MachineTheme,
    type PracticeDifficulty,
  } from '../../lib/morse-machine-ui?mm';

  const root = document.querySelector<HTMLElement>('[data-morse-machine]');
  const card = root?.querySelector<HTMLElement>('[data-card]');
  const morseOut = root?.querySelector<HTMLElement>('[data-morse-out]');
  const textOut = root?.querySelector<HTMLElement>('[data-text-out]');
  const hint = root?.querySelector<HTMLElement>('[data-hint]');
  const pad = root?.querySelector<HTMLButtonElement>('[data-pad]');
  const typeField = root?.querySelector<HTMLTextAreaElement>('[data-type]');
  const speedInput = root?.querySelector<HTMLInputElement>('[data-speed]');
  const speedValue = root?.querySelector<HTMLElement>('[data-speed-value]');
  const volumeInput = root?.querySelector<HTMLInputElement>('[data-volume]');
  const volumeValue = root?.querySelector<HTMLElement>('[data-volume-value]');
  const pitchInput = root?.querySelector<HTMLInputElement>('[data-pitch]');
  const pitchValue = root?.querySelector<HTMLElement>('[data-pitch-value]');
  const sidetoneOnInput = root?.querySelector<HTMLInputElement>('[data-sidetone-on]');
  const clearButton = root?.querySelector<HTMLButtonElement>('[data-clear]');
  const playButton = root?.querySelector<HTMLButtonElement>('[data-play]');
  const replayButton = root?.querySelector<HTMLButtonElement>('[data-replay]');
  const checkButton = root?.querySelector<HTMLButtonElement>('[data-check]');
  const nextButton = root?.querySelector<HTMLButtonElement>('[data-next]');
  const targetOut = root?.querySelector<HTMLElement>('[data-target]');
  const feedbackOut = root?.querySelector<HTMLElement>('[data-feedback]');
  const modeInputs = [...(root?.querySelectorAll<HTMLInputElement>('input[data-mode]') ?? [])];
  const activityInputs = [...(root?.querySelectorAll<HTMLInputElement>('input[data-activity]') ?? [])];
  const diffInputs = [...(root?.querySelectorAll<HTMLInputElement>('input[data-diff]') ?? [])];
  const themeToggle = root?.querySelector<HTMLButtonElement>('[data-mm-theme-toggle]');
  const ditBtn = root?.querySelector<HTMLButtonElement>('[data-paddle="dot"]');
  const dahBtn = root?.querySelector<HTMLButtonElement>('[data-paddle="dash"]');

  if (
    root &&
    card &&
    morseOut &&
    textOut &&
    hint &&
    pad &&
    typeField &&
    speedInput &&
    speedValue &&
    volumeInput &&
    volumeValue &&
    pitchInput &&
    pitchValue &&
    sidetoneOnInput &&
    clearButton &&
    playButton &&
    replayButton &&
    checkButton &&
    nextButton &&
    targetOut &&
    feedbackOut &&
    themeToggle &&
    ditBtn &&
    dahBtn
  ) {
    const clock = { now: () => performance.now() };
    let wpm = clampMachineWpm(Number(speedInput.value) || DEFAULT_IAMBIC_WPM);
    let mode: MachineMode = 'key';
    let activity: MachineActivity = 'send';
    let difficulty: PracticeDifficulty = 'character';
    let prompt: ListenAndGuessPrompt | null = null;
    let sidetoneOn = sidetoneOnInput.checked;
    let volume = clampSidetoneVolume(Number(volumeInput.value));
    let pitch = clampSidetonePitch(Number(pitchInput.value));
    const keySession = createStraightKeySession({ clock, wpm });
    let keyer: IambicKeyer = createIambicKeyer({ clock, wpm });
    let paddleEvents: MorseKeyEvent[] = [];
    let tickTimer = 0;
    const paddleHeld: Record<IambicSide, boolean> = { dot: false, dash: false };
    const sidetone = createSidetone({
      getSettings: () => ({
        enabled: sidetoneOn && liveSidetoneAllowed(mode),
        volume,
        frequency: pitch,
      }),
    });

    const currentEvents = () => (mode === 'paddle' ? paddleEvents : keySession.events());

    const render = () => {
      const display = displayForMode(mode, currentEvents(), typeField.value);
      morseOut.textContent = display.morse;
      textOut.textContent = display.text;
    };

    const setFeedback = (kind: '' | 'correct' | 'incorrect', text = '') => {
      feedbackOut.dataset.kind = kind;
      feedbackOut.textContent = text;
    };

    const renderPractice = () => {
      if (activity === 'letter') targetOut.textContent = prompt?.text ?? '';
      else targetOut.textContent = '';
    };

    const resetSend = () => {
      keySession.clear();
      paddleEvents = [];
      keyer.clear();
      paddleHeld.dot = false;
      paddleHeld.dash = false;
      setPressed(pad, false);
      setPressed(ditBtn, false);
      setPressed(dahBtn, false);
      typeField.value = '';
      sidetone.stopLive();
      render();
    };

    const setPrompt = (next: ListenAndGuessPrompt) => {
      prompt = next;
      setFeedback('', '');
      renderPractice();
    };

    const ensurePrompt = () => {
      if (!prompt) setPrompt(nextPracticePrompt(difficulty));
      return prompt;
    };

    const setPressed = (button: HTMLButtonElement, pressed: boolean) => {
      button.dataset.pressed = pressed ? 'true' : 'false';
    };

    const takePaddle = (events: MorseKeyEvent[]) => {
      if (!events.length) return;
      paddleEvents.push(...events);
      if (liveSidetoneAllowed(mode)) {
        for (const event of events) {
          if (event.kind === 'mark') sidetone.playMark(event.mark, wpm);
        }
      }
    };

    const ensureTick = () => {
      if (tickTimer || mode === 'type') return;
      tickTimer = window.setInterval(() => {
        if (mode === 'key') keySession.tick();
        else if (mode === 'paddle') takePaddle(keyer.tick());
        render();
      }, 40);
    };

    const stopTick = () => {
      if (!tickTimer) return;
      window.clearInterval(tickTimer);
      tickTimer = 0;
    };

    const setMode = (next: MachineMode) => {
      if (next === 'type') sidetone.stopLive();
      mode = next;
      card.dataset.mode = next;
      hint.textContent = MACHINE_MODE_HINT[next];
      if (next === 'type') stopTick();
      else ensureTick();
      if (next === 'key') pad.focus();
      else if (next === 'type') typeField.focus();
      render();
    };

    const setActivity = (next: MachineActivity) => {
      activity = next;
      card.dataset.activity = next;
      sidetone.stopPlayback();
      if (next === 'send') {
        renderPractice();
        return;
      }
      ensurePrompt();
      renderPractice();
    };

    const setDifficulty = (next: PracticeDifficulty) => {
      difficulty = next;
      resetSend();
      setPrompt(nextPracticePrompt(difficulty));
    };

    const setTheme = (next: MachineTheme) => {
      root.dataset.mmTheme = next;
      const label = machineThemeToggleLabel(next);
      themeToggle.setAttribute('aria-pressed', next === 'dark' ? 'true' : 'false');
      themeToggle.setAttribute('aria-label', label);
      themeToggle.textContent = label;
    };

    const setWpm = (next: number) => {
      wpm = clampMachineWpm(next);
      speedInput.value = String(wpm);
      speedValue.textContent = `${wpm} WPM`;
      keySession.setWpm(wpm);
      const held = { ...paddleHeld };
      keyer = createIambicKeyer({ clock, wpm });
      if (held.dot) keyer.paddleDown('dot');
      if (held.dash) keyer.paddleDown('dash');
    };

    const setPaddle = (side: IambicSide, down: boolean) => {
      if (paddleHeld[side] === down) return;
      paddleHeld[side] = down;
      setPressed(side === 'dot' ? ditBtn : dahBtn, down);
      takePaddle(down ? keyer.paddleDown(side) : keyer.paddleUp(side));
      ensureTick();
      render();
    };

    const playPrompt = () => {
      const current = ensurePrompt();
      if (!current || activity !== 'listen') return;
      void sidetone.unlock().then(() => sidetone.playMorse(current.morse, wpm));
    };

    const checkAnswer = () => {
      const current = ensurePrompt();
      if (!current || activity === 'send') return;
      const score = checkPractice(current.text, mode, currentEvents(), typeField.value);
      const feedback = practiceFeedback(score, { revealAnswer: activity === 'listen' });
      setFeedback(feedback.kind, feedback.text);
    };

    const bindPointerKey = (button: HTMLButtonElement, onDown: () => void, onUp: () => void) => {
      let pointerId: number | null = null;
      button.addEventListener('pointerdown', (event) => {
        if (pointerId !== null) return;
        event.preventDefault();
        pointerId = event.pointerId;
        try {
          button.setPointerCapture(event.pointerId);
        } catch {
          // ignore
        }
        onDown();
      });
      const end = (event: PointerEvent) => {
        if (pointerId === null || event.pointerId !== pointerId) return;
        pointerId = null;
        try {
          button.releasePointerCapture(event.pointerId);
        } catch {
          // ignore
        }
        onUp();
      };
      button.addEventListener('pointerup', end);
      button.addEventListener('pointercancel', end);
      button.addEventListener('contextmenu', (event) => event.preventDefault());
    };

    bindPointerKey(
      pad,
      () => {
        setPressed(pad, true);
        keySession.down();
        sidetone.startLive();
        ensureTick();
      },
      () => {
        setPressed(pad, false);
        keySession.up();
        sidetone.stopLive();
        render();
      },
    );
    bindPointerKey(
      ditBtn,
      () => setPaddle('dot', true),
      () => setPaddle('dot', false),
    );
    bindPointerKey(
      dahBtn,
      () => setPaddle('dash', true),
      () => setPaddle('dash', false),
    );

    const shouldIgnoreKey = (target: EventTarget | null) => {
      if (!(target instanceof HTMLElement)) return false;
      if (target === pad || target === ditBtn || target === dahBtn) return false;
      if (target instanceof HTMLTextAreaElement || target instanceof HTMLButtonElement) return true;
      if (target instanceof HTMLInputElement) return true;
      return Boolean(target.closest('summary'));
    };

    window.addEventListener('keydown', (event) => {
      if (event.repeat) {
        if (mode === 'key' && (event.code === 'Space' || event.key === ' ')) event.preventDefault();
        if (mode === 'paddle' && (event.code === 'ArrowLeft' || event.code === 'ArrowRight')) event.preventDefault();
        return;
      }
      if (mode === 'key' && (event.code === 'Space' || event.key === ' ')) {
        if (shouldIgnoreKey(event.target)) return;
        event.preventDefault();
        setPressed(pad, true);
        keySession.down();
        sidetone.startLive();
        ensureTick();
        return;
      }
      if (mode !== 'paddle' || shouldIgnoreKey(event.target)) return;
      if (event.code === 'ArrowLeft' || event.code === 'KeyJ') {
        event.preventDefault();
        setPaddle('dot', true);
      } else if (event.code === 'ArrowRight' || event.code === 'KeyK') {
        event.preventDefault();
        setPaddle('dash', true);
      }
    });

    window.addEventListener('keyup', (event) => {
      if (mode === 'key' && (event.code === 'Space' || event.key === ' ')) {
        if (shouldIgnoreKey(event.target)) return;
        event.preventDefault();
        setPressed(pad, false);
        keySession.up();
        sidetone.stopLive();
        render();
        return;
      }
      if (mode !== 'paddle' || shouldIgnoreKey(event.target)) return;
      if (event.code === 'ArrowLeft' || event.code === 'KeyJ') {
        event.preventDefault();
        setPaddle('dot', false);
      } else if (event.code === 'ArrowRight' || event.code === 'KeyK') {
        event.preventDefault();
        setPaddle('dash', false);
      }
    });

    typeField.addEventListener('input', render);

    for (const input of modeInputs) {
      input.addEventListener('change', () => {
        if (input.checked && isMachineMode(input.value)) setMode(input.value);
      });
    }

    for (const input of activityInputs) {
      input.addEventListener('change', () => {
        if (input.checked && isMachineActivity(input.value)) setActivity(input.value);
      });
    }

    for (const input of diffInputs) {
      input.addEventListener('change', () => {
        if (input.checked && isPracticeDifficulty(input.value)) setDifficulty(input.value);
      });
    }

    themeToggle.addEventListener('click', () => {
      setTheme(root.dataset.mmTheme === 'dark' ? 'light' : 'dark');
    });

    speedInput.addEventListener('input', () => setWpm(Number(speedInput.value)));
    volumeInput.addEventListener('input', () => {
      volume = clampSidetoneVolume(Number(volumeInput.value));
      volumeValue.textContent = `${volume}%`;
    });
    pitchInput.addEventListener('input', () => {
      pitch = clampSidetonePitch(Number(pitchInput.value));
      pitchValue.textContent = `${pitch} Hz`;
    });
    sidetoneOnInput.addEventListener('change', () => {
      sidetoneOn = sidetoneOnInput.checked;
      if (!sidetoneOn) sidetone.stopLive();
    });

    playButton.addEventListener('click', playPrompt);
    replayButton.addEventListener('click', playPrompt);
    checkButton.addEventListener('click', checkAnswer);
    nextButton.addEventListener('click', () => {
      resetSend();
      setPrompt(nextPracticePrompt(difficulty));
    });

    clearButton.addEventListener('click', () => {
      resetSend();
      setFeedback('', '');
    });

    const pageTheme = document.documentElement.getAttribute('data-theme');
    if (pageTheme && isMachineTheme(pageTheme)) setTheme(pageTheme);

    setMode('key');
    setActivity('send');
    ensureTick();
    render();
  }
</script>
