---
/**
 * Click-to-load YouTube facade. The poster is a same-origin image, so page load
 * makes no request to YouTube. The iframe is created only after an explicit click.
 */
import { Image } from 'astro:assets';
import poster from '../assets/article/demo-video-poster.jpg';
import '../styles/demo-video.css';

const videoId = 'Ni3vz9gQCgA';
const title = 'Morse Code Translator: Free Online Text to Morse Converter with Audio';
const embedSrc = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1`;

const figure = 'overflow-hidden rounded-xl border border-line bg-surface';
const caption = 'border-t border-line bg-canvas px-3 py-2 text-sm text-muted';
---

<figure class={figure} data-demo-video-figure>
  <div class="demo-video" data-demo-video data-embed={embedSrc} data-title={title}>
    <button
      class="demo-video-facade"
      type="button"
      data-demo-video-play
      aria-label="Play demo video: Morse Code Translator"
    >
      <Image
        src={poster}
        alt=""
        widths={[480, 768, 1280]}
        sizes="(max-width: 640px) 100vw, 928px"
        loading="lazy"
        decoding="async"
        width={1280}
        height={720}
        class="demo-video-poster"
      />
      <span class="demo-video-play" aria-hidden="true">
        <svg class="demo-video-play-icon" viewBox="0 0 16 16" focusable="false">
          <path d="M4.5 2.8v10.4L13 8z" fill="currentColor"></path>
        </svg>
      </span>
    </button>
  </div>
  <figcaption class={caption}>{title}</figcaption>
</figure>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-demo-video]');
    if (!root || root.getAttribute('data-bound')) return;
    root.setAttribute('data-bound', '1');
    root.addEventListener('click', function (event) {
      var button = event.target.closest('[data-demo-video-play]');
      if (!button || !root.contains(button) || root.getAttribute('data-ready')) return;
      var src = root.getAttribute('data-embed');
      var title = root.getAttribute('data-title') || 'Demo video';
      if (!src) return;
      root.setAttribute('data-ready', '1');
      var frame = document.createElement('iframe');
      frame.src = src;
      frame.title = title;
      frame.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      frame.setAttribute('allowfullscreen', '');
      frame.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
      button.replaceWith(frame);
      frame.focus();
    });
  })();
</script>
