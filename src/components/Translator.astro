---
import '../styles/translator.css';
import { MORSE_ALPHABET } from '../lib/morse';

const fieldClass =
  'relative z-10 mt-1 h-20 w-full resize-none rounded-xl border border-line bg-transparent px-3 py-2 text-base text-ink caret-ink';
const mirrorClass =
  'pointer-events-none absolute inset-0 z-0 mt-1 overflow-hidden whitespace-pre-wrap break-words rounded-xl border border-transparent bg-canvas px-3 py-2 text-base text-ink [&_mark]:rounded-sm [&_mark]:bg-[#f5d76e] [&_mark]:text-[#12141a] dark:[&_mark]:bg-[#c9a227] dark:[&_mark]:text-[#12141a]';
const quietButton = 'btn btn-secondary';
const shareButton = 'btn btn-primary';
const ghostButton = 'btn btn-ghost';
const counterClass = 'mt-1 min-h-5 text-sm text-muted';
const detailsClass = 'disclosure';
const fieldSelect =
  'min-h-11 w-full rounded-xl border border-line bg-surface px-3 text-sm text-ink';
const referenceEntries = MORSE_ALPHABET;

/** Compact <use> reference into the page-local SVG sprite (defined once below). */
const icon = (id: string, cls = 'btn-icon') =>
  `<svg class="${cls}" aria-hidden="true"><use href="#${id}"/></svg>`;
const iconCopy = icon('i-copy');
const iconShare = icon('i-share');
const iconClear = icon('i-clear');
const iconStop = icon('i-stop');
const iconDownload = icon('i-download');
const iconGear = icon('i-gear');
const iconBook = icon('i-book');
const iconChevron = icon('i-chevron', 'disclosure-chevron');
/** Width placeholder for flash labels — no SVG nodes (face icon is the real check). */
const iconCheckSlot = `<span class="inline-block size-4 shrink-0" aria-hidden="true"></span>`;
const iconCheckFace = `<svg data-i class="hidden size-4 shrink-0" aria-hidden="true"><use href="#i-check"/></svg>`;
---

<section
  class="translator rounded-2xl border border-line bg-surface p-2.5 sm:p-4"
  data-translator
  data-copy-error="Couldn't copy automatically. Select the text and press Ctrl+C (or Cmd+C)."
>
  {/* Single sprite: paths defined once; buttons reference via <use> to cut HTML/DOM weight. */}
  <svg class="icon-sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <defs>
      <symbol
        id="i-copy"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="5.5" y="5.5" width="7" height="8" rx="1.25"></rect>
        <path d="M3.5 10.5V3.75A1.25 1.25 0 0 1 4.75 2.5H10"></path>
      </symbol>
      <symbol
        id="i-share"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="3.5" r="1.75"></circle>
        <circle cx="12" cy="12.5" r="1.75"></circle>
        <circle cx="4" cy="8" r="1.75"></circle>
        <path d="m5.6 7.2 4.8-2.7M5.6 8.8l4.8 2.7"></path>
      </symbol>
      <symbol
        id="i-clear"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
      >
        <path d="M4 4l8 8M12 4l-8 8"></path>
      </symbol>
      <symbol id="i-play" viewBox="0 0 16 16" fill="currentColor">
        <path d="M4.5 2.8v10.4L13 8z"></path>
      </symbol>
      <symbol id="i-stop" viewBox="0 0 16 16" fill="currentColor">
        <rect x="4" y="4" width="8" height="8" rx="1"></rect>
      </symbol>
      <symbol
        id="i-download"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M8 2.5v8M4.5 7.5 8 11l3.5-3.5M3 13.5h10"></path>
      </symbol>
      <symbol
        id="i-gear"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path
          d="M6 3.5h4l.7 1.4 1.5.4 1 1.2-.7 1.4.7 1.4-1 1.2-1.5.4L10 12.5H6l-.7-1.4-1.5-.4-1-1.2.7-1.4-.7-1.4 1-1.2 1.5-.4L6 3.5z"
        ></path>
        <circle cx="8" cy="8" r="1.6"></circle>
      </symbol>
      <symbol
        id="i-book"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M3.5 3.5h7.5A1.5 1.5 0 0 1 12.5 5v7.5H5A1.5 1.5 0 0 0 3.5 14z"></path>
        <path d="M3.5 3.5V14"></path>
      </symbol>
      <symbol
        id="i-chevron"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="m6 3.5 5 4.5-5 4.5"></path>
      </symbol>
      <symbol
        id="i-check"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M3 8.5 6.2 12 13 4"></path>
      </symbol>
    </defs>
  </svg>
  <div class="flex flex-wrap items-stretch gap-1.5">
    <div class="mode-seg" role="radiogroup" aria-label="Translation direction" data-mode-group>
      <label class="mode-seg__opt">
        <input class="sr-only" type="radio" name="translator-mode" value="text-to-morse" checked data-mode />
        <span>Text to Morse</span>
      </label>
      <label class="mode-seg__opt">
        <input class="sr-only" type="radio" name="translator-mode" value="morse-to-text" data-mode />
        <span>Morse to Text</span>
      </label>
      <label class="mode-seg__opt">
        <input class="sr-only" type="radio" name="translator-mode" value="tap-input" data-mode />
        <span>Tap input</span>
      </label>
      <label class="mode-seg__opt">
        <input class="sr-only" type="radio" name="translator-mode" value="mic-listen" data-mode />
        <span>Listen (mic)</span>
      </label>
    </div>
    <button class={quietButton} type="button" data-swap aria-label="Swap input and output">Swap</button>
  </div>

  <div class="mt-2 hidden" data-tap-mount hidden></div>
  <div class="mt-2 hidden" data-mic-mount hidden></div>

  <div class="mt-2 grid gap-2" data-panels>
    <div data-panel="text">
      <div class="flex items-center justify-between gap-2">
        <label class="text-sm font-semibold" for="translator-text">Text</label>
      </div>
      <div class="relative" data-text-shell>
        <div class={`${mirrorClass}`} aria-hidden="true" data-text-mirror></div>
        <textarea
          id="translator-text"
          class={fieldClass}
          rows="3"
          spellcheck="false"
          autocomplete="off"
          autocapitalize="off"
          placeholder="Type letters, numbers, or punctuation"></textarea>
        <div
          class="absolute inset-0 z-20 mt-1 hidden items-center justify-center rounded-xl border border-line bg-canvas px-3 text-sm text-muted"
          data-text-mask
          hidden
        >
          <span>Text hidden</span>
          <button class={`${quietButton} ml-3`} type="button" data-show-text>Show text</button>
        </div>
      </div>
      <p class={counterClass} data-text-count aria-hidden="true">0 characters</p>
    </div>
    <div data-panel="morse">
      <label class="text-sm font-semibold" for="translator-morse">Morse code</label>
      <div class="relative" data-morse-shell>
        <div class={`${mirrorClass} font-mono tracking-wide`} aria-hidden="true" data-morse-mirror></div>
        <textarea
          id="translator-morse"
          class={`${fieldClass} font-mono tracking-wide`}
          rows="3"
          spellcheck="false"
          autocomplete="off"
          autocapitalize="off"
          placeholder="Type dots, dashes, and spaces"></textarea>
      </div>
      {/* Docked play bar: below the textarea (never overlays content), above the signal counter. */}
      <div class="playbar" data-playbar>
        <button
          id="translator-play"
          class="play-btn"
          type="button"
          data-play
          disabled
          aria-label="Play"
        >
          <Fragment set:html={icon('i-play', 'play-btn-icon')} />
          <span class="play-btn-label">Play</span>
        </button>
        <div class="playbar-meter">
          <div
            class="playbar-track"
            role="progressbar"
            aria-label="Playback progress"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
            data-play-progress
          >
            <div class="playbar-fill" data-play-progress-fill></div>
          </div>
          <p class="playbar-time" data-play-time aria-hidden="true">0:00</p>
        </div>
      </div>
      <p class={counterClass} data-morse-count aria-hidden="true">0 signals</p>
    </div>
  </div>

  <div class="mt-2 flex flex-wrap gap-2">
    <button
      class={`${quietButton} data-[state=copied]:border-accent`}
      type="button"
      data-copy="translator-text"
      data-label="Copy text"
      data-flash="Copied"
      aria-label="Copy text"
    >
      <Fragment set:html={iconCopy} />
      <span class="inline-grid">
        <span class="invisible col-start-1 row-start-1 inline-flex items-center gap-1" aria-hidden="true"
          ><Fragment set:html={iconCheckSlot} />Copied</span
        >
        <span class="invisible col-start-1 row-start-1" aria-hidden="true">Copy text</span>
        <span class="col-start-1 row-start-1 inline-flex items-center justify-center gap-1" data-face
          ><Fragment set:html={iconCheckFace} /><span data-t>Copy text</span></span
        >
      </span>
    </button>
    <button
      class={`${quietButton} data-[state=copied]:border-accent`}
      type="button"
      data-copy="translator-morse"
      data-label="Copy Morse code"
      data-flash="Copied"
      aria-label="Copy Morse code"
    >
      <Fragment set:html={iconCopy} />
      <span class="inline-grid">
        <span class="invisible col-start-1 row-start-1 inline-flex items-center gap-1" aria-hidden="true"
          ><Fragment set:html={iconCheckSlot} />Copied</span
        >
        <span class="invisible col-start-1 row-start-1" aria-hidden="true">Copy Morse code</span>
        <span class="col-start-1 row-start-1 inline-flex items-center justify-center gap-1" data-face
          ><Fragment set:html={iconCheckFace} /><span data-t>Copy Morse code</span></span
        >
      </span>
    </button>
    <button class={ghostButton} type="button" data-clear data-announce="Cleared"
      ><Fragment set:html={iconClear} />Clear</button
    >
    <button class={quietButton} type="button" data-random>Random example</button>
  </div>

  <p id="translator-status" class="mt-2 min-h-6 text-sm text-muted" aria-live="polite">
    <span id="translator-announce" class="sr-only"></span>
    <span id="translator-notice"></span>
  </p>

  <div class="mt-2 flex flex-wrap gap-2">
    <button
      class={`${shareButton} data-[state=copied]:border-on-accent`}
      type="button"
      data-share-copy
      data-label="Copy share link"
      data-flash="Link copied"
      aria-label="Copy share link"
    >
      <Fragment set:html={iconShare} />
      <span class="inline-grid">
        <span class="invisible col-start-1 row-start-1 inline-flex items-center gap-1" aria-hidden="true"
          ><Fragment set:html={iconCheckSlot} />Link copied</span
        >
        <span class="invisible col-start-1 row-start-1" aria-hidden="true">Copy share link</span>
        <span class="col-start-1 row-start-1 inline-flex items-center justify-center gap-1" data-face
          ><Fragment set:html={iconCheckFace} /><span data-t>Copy share link</span></span
        >
      </span>
    </button>
    <button
      class={`${quietButton} data-[state=copied]:border-accent`}
      type="button"
      data-share-native
      data-label="Share"
      data-flash="Link copied"
      aria-label="Share"
    >
      <Fragment set:html={iconShare} />
      <span class="inline-grid">
        <span class="invisible col-start-1 row-start-1 inline-flex items-center gap-1" aria-hidden="true"
          ><Fragment set:html={iconCheckSlot} />Link copied</span
        >
        <span class="invisible col-start-1 row-start-1" aria-hidden="true">Share</span>
        <span class="col-start-1 row-start-1 inline-flex items-center justify-center gap-1" data-face
          ><Fragment set:html={iconCheckFace} /><span data-t>Share</span></span
        >
      </span>
    </button>
    <button
      class={`${quietButton} data-[state=copied]:border-accent`}
      type="button"
      data-puzzle
      data-label="Copy puzzle link"
      data-flash="Link copied"
      aria-label="Copy puzzle link"
      disabled
    >
      <Fragment set:html={iconCopy} />
      <span class="inline-grid">
        <span class="invisible col-start-1 row-start-1 inline-flex items-center gap-1" aria-hidden="true"
          ><Fragment set:html={iconCheckSlot} />Link copied</span
        >
        <span class="invisible col-start-1 row-start-1" aria-hidden="true">Copy puzzle link</span>
        <span class="col-start-1 row-start-1 inline-flex items-center justify-center gap-1" data-face
          ><Fragment set:html={iconCheckFace} /><span data-t>Copy puzzle link</span></span
        >
      </span>
    </button>
    <button class={quietButton} type="button" data-export-txt disabled
      ><Fragment set:html={iconDownload} />Export TXT</button
    >
  </div>

  <details class={`${detailsClass} mt-2`}>
    <summary
      ><Fragment set:html={iconChevron} /><Fragment set:html={iconGear} />Settings</summary
    >
    <div class="grid gap-3 border-t border-line px-3 py-3 text-sm">
      <label class="toggle-row">
        <input class="toggle-input" type="checkbox" checked data-slash />
        <span class="toggle-ui" aria-hidden="true"></span>
        <span>Show slash between words</span>
      </label>
      <label class="toggle-row">
        <input class="toggle-input" type="checkbox" data-hide-text />
        <span class="toggle-ui" aria-hidden="true"></span>
        <span>Hide text</span>
      </label>
      <label class="toggle-row">
        <input class="toggle-input" type="checkbox" data-autoplay />
        <span class="toggle-ui" aria-hidden="true"></span>
        <span>Autoplay</span>
      </label>
      <div class="grid gap-1">
        <label class="toggle-row">
          <input class="toggle-input" type="checkbox" data-flash-opt />
          <span class="toggle-ui" aria-hidden="true"></span>
          <span>Flash</span>
        </label>
        <p class="text-xs text-muted" data-flash-warning>
          Flashing light. Not suitable for people who are sensitive to flashing lights.
        </p>
        <p class="hidden text-xs text-muted" data-flash-reduced>
          Flash is off because your system asks to reduce motion.
        </p>
      </div>
      <div class="grid gap-1">
        <label class="toggle-row">
          <input class="toggle-input" type="checkbox" data-vibration />
          <span class="toggle-ui" aria-hidden="true"></span>
          <span>Vibration</span>
        </label>
        <p class="hidden text-xs text-muted" data-vibration-note>
          Not supported on this device (iPhone and most desktop browsers do not support it).
        </p>
      </div>
      <div class="grid gap-2 border-t border-line pt-3" data-audio-settings>
        <p class="font-semibold">Audio</p>
        <label class="grid gap-1" for="translator-preset">
          <span class="font-medium">Preset</span>
          <select id="translator-preset" class={fieldSelect} data-preset>
            <option value="custom">Custom</option>
            <option value="slow">Slow</option>
            <option value="beginner">Beginner</option>
            <option value="practice">Practice</option>
            <option value="standard" selected>Standard</option>
            <option value="fast">Fast</option>
          </select>
        </label>
        <label class="grid gap-1" for="translator-sound-type">
          <span class="font-medium">Sound type</span>
          <select id="translator-sound-type" class={fieldSelect} data-sound-type>
            <option value="cw" selected>CW tone</option>
            <option value="telegraph">Telegraph click</option>
          </select>
        </label>
        <label class="grid gap-1" for="translator-waveform">
          <span class="font-medium">Waveform</span>
          <select id="translator-waveform" class={fieldSelect} data-waveform>
            <option value="sine" selected>Sine</option>
            <option value="square">Square</option>
          </select>
        </label>
        <p class="hidden text-xs text-muted" data-waveform-note>Waveform applies to CW tone only.</p>
        <label class="grid min-h-11 content-center gap-1" for="translator-tone">
          <span class="flex items-baseline justify-between gap-3 font-medium">
            <span>Tone (Hz)</span>
            <output id="translator-tone-value" for="translator-tone">600</output>
          </span>
          <input id="translator-tone" class="h-11 w-full" type="range" min="400" max="900" value="600" disabled />
        </label>
        <label class="grid min-h-11 content-center gap-1" for="translator-volume">
          <span class="flex items-baseline justify-between gap-3 font-medium">
            <span>Volume</span>
            <output id="translator-volume-value" for="translator-volume">70</output>
          </span>
          <input id="translator-volume" class="h-11 w-full" type="range" min="0" max="100" value="70" disabled />
        </label>
      </div>
    </div>
  </details>

  <details class={`${detailsClass} mt-2`}>
    <summary
      ><Fragment set:html={iconChevron} /><Fragment set:html={iconBook} />Reference</summary
    >
    <div class="border-t border-line px-3 py-3">
      <div class="grid grid-cols-4 gap-x-2 gap-y-1 text-sm sm:grid-cols-6 md:grid-cols-8">
        {
          referenceEntries.map((entry) => (
            <div class="flex min-w-0 items-baseline justify-between gap-1 font-mono">
              <span class="font-sans font-semibold text-ink">{entry.char}</span>
              <span class="truncate text-muted">{entry.code}</span>
            </div>
          ))
        }
      </div>
      <p class="mt-3 text-sm">
        <a class="font-medium text-accent underline underline-offset-2" href="/morse-code-alphabet/"
          >Full alphabet chart</a
        >
      </p>
    </div>
  </details>

  <div class="mt-3 grid gap-3 border-t border-line pt-3">
    <p class="text-sm font-semibold">Audio</p>
    <div class="flex flex-wrap items-start gap-2">
      {/* Primary Play lives in the Morse panel playbar (above the fold). */}
      {/* Pause/Resume text is set via textContent in script — no child icon. */}
      <button id="translator-pause" class={quietButton} type="button" data-pause disabled>Pause</button>
      <button id="translator-stop" class={quietButton} type="button" data-stop disabled
        ><Fragment set:html={iconStop} />Stop</button
      >
      <button
        id="translator-repeat"
        class={quietButton}
        type="button"
        data-repeat
        aria-pressed="false"
        aria-label="Repeat"
      >
        Repeat
      </button>
      <button
        id="translator-wav"
        class={quietButton}
        type="button"
        data-wav
        disabled
        aria-label="Download WAV"
        data-label="Download WAV"
        data-busy="Preparing..."
      >
        <Fragment set:html={iconDownload} />
        <span class="inline-grid">
          <span class="invisible col-start-1 row-start-1" aria-hidden="true">Download WAV</span>
          <span class="invisible col-start-1 row-start-1" aria-hidden="true">Preparing...</span>
          <span class="col-start-1 row-start-1" data-face>Download WAV</span>
        </span>
      </button>
      <div
        class="size-24 shrink-0 rounded-full bg-[#2a2f38]"
        style="background: #2a2f38"
        aria-hidden="true"
        data-lamp
        data-lit="false"
      >
      </div>
    </div>
    <p id="translator-audio-status" class="min-h-6 text-sm text-muted" aria-live="polite"></p>
    <div class="grid gap-3 sm:grid-cols-2">
      <label class="grid min-h-11 content-center gap-1 text-sm" for="translator-wpm">
        <span class="flex items-baseline justify-between gap-3 font-medium">
          <span>Speed (WPM)</span>
          <output id="translator-wpm-value" for="translator-wpm">20</output>
        </span>
        <input id="translator-wpm" class="h-11 w-full" type="range" min="5" max="40" value="20" disabled />
      </label>
      <label class="grid min-h-11 content-center gap-1 text-sm" for="translator-farnsworth">
        <span class="flex items-baseline justify-between gap-3 font-medium">
          <span>Farnsworth (overall speed)</span>
          <output id="translator-farnsworth-value" for="translator-farnsworth">Off</output>
        </span>
        <input id="translator-farnsworth" class="h-11 w-full" type="range" min="5" max="40" value="20" disabled />
      </label>
    </div>
    <p class="min-h-6 text-sm text-muted">No sound on iPhone? Turn off silent mode.</p>
  </div>
  <noscript>
    <p class="text-sm text-muted"
      >JavaScript is off, so the panels and audio controls will not run. The chart below still works.</p
    >
  </noscript>
</section>

<style>
  [data-translator] [data-text-mirror] mark,
  [data-translator] [data-morse-mirror] mark {
    background: #f5d76e;
    color: #12141a;
  }
  :root[data-theme='dark'] [data-translator] [data-text-mirror] mark,
  :root[data-theme='dark'] [data-translator] [data-morse-mirror] mark {
    background: #c9a227;
    color: #12141a;
  }
  /* Lamp lit styles live in global.css so the brass bezel stays consistent. */
  [data-translator] textarea.is-highlighting {
    color: transparent;
  }
</style>

<script>
  import { copyWithFallback } from '../lib/copy-feedback';
  import { applyPreset, matchPreset, type PresetId } from '../lib/audio-presets';
  import { transportButtons } from '../lib/audio-transport';
  import { changeFarnsworth, changeSpeed, farnsworthLabel } from '../lib/farnsworth';
  import { decode, encode } from '../lib/morse';
  import {
    buildPuzzleUrl,
    buildShareUrl,
    canAutoplayMorse,
    characterCountLabel,
    convertWordSeparators,
    countCharacters,
    countSignals,
    createAutoplayController,
    modeAnnouncement,
    parseTranslatorHash,
    pickRandomExample,
    signalCountLabel,
    swapMode,
    unknownMorseNotice,
    unsupportedNotice,
    wordSeparatorFor,
    type TranslatorMode,
  } from '../lib/translator-core';

  const root = document.querySelector('[data-translator]');
  const text = document.querySelector('#translator-text');
  const morse = document.querySelector('#translator-morse');
  const notice = document.querySelector('#translator-notice');
  const announce = document.querySelector('#translator-announce');
  const panels = document.querySelector('[data-panels]');
  const textPanel = document.querySelector('[data-panel="text"]');
  const morsePanel = document.querySelector('[data-panel="morse"]');
  const textCount = document.querySelector('[data-text-count]');
  const morseCount = document.querySelector('[data-morse-count]');
  const textMask = document.querySelector('[data-text-mask]');
  const slashInput = document.querySelector('[data-slash]');
  const hideInput = document.querySelector('[data-hide-text]');
  const puzzleButton = document.querySelector('[data-puzzle]');
  const exportButton = document.querySelector('[data-export-txt]');

  if (
    root instanceof HTMLElement &&
    text instanceof HTMLTextAreaElement &&
    morse instanceof HTMLTextAreaElement &&
    notice instanceof HTMLElement &&
    announce instanceof HTMLElement &&
    panels instanceof HTMLElement &&
    textPanel instanceof HTMLElement &&
    morsePanel instanceof HTMLElement &&
    textCount instanceof HTMLElement &&
    morseCount instanceof HTMLElement &&
    textMask instanceof HTMLElement &&
    slashInput instanceof HTMLInputElement &&
    hideInput instanceof HTMLInputElement
  ) {
    let lock = false;
    let preparingWav = false;
    let lastSource: 'text' | 'morse' = 'text';
    let mode: TranslatorMode = 'text-to-morse';
    let lastExample: string | null = null;
    let actionsLoading: Promise<typeof import('../lib/translator-actions')> | null = null;
    let tapLoading: Promise<{ mountTapMode: typeof import('../lib/tap-input').mountTapMode }> | null = null;
    let tapHandle: { focusPad: () => void; destroy: () => void; clear: () => void } | null = null;
    let micLoading: Promise<{ mountMicMode: typeof import('../lib/mic-input').mountMicMode }> | null = null;
    let micHandle: { focusStart: () => void; destroy: () => void; clear: () => void } | null = null;
    let allowAutoplay = false;
    const tapMount = root.querySelector('[data-tap-mount]');
    const micMount = root.querySelector('[data-mic-mount]');
    const swapButton = root.querySelector('[data-swap]');
    const textMirror = root.querySelector('[data-text-mirror]');
    const morseMirror = root.querySelector('[data-morse-mirror]');
    const autoplayInput = root.querySelector('[data-autoplay]');
    const flashInput = root.querySelector('[data-flash-opt]');
    const vibrationInput = root.querySelector('[data-vibration]');
    const presetSelect = root.querySelector('[data-preset]');
    const soundTypeSelect = root.querySelector('[data-sound-type]');
    const waveformSelect = root.querySelector('[data-waveform]');
    const waveformNote = root.querySelector('[data-waveform-note]');
    const lamp = root.querySelector('[data-lamp]');
    const pauseButton = root.querySelector('#translator-pause');
    const stopButton = root.querySelector('#translator-stop');
    const repeatButton = root.querySelector('#translator-repeat');
    const autoplay = createAutoplayController();

    const showNotice = (message: string) => {
      notice.textContent = message;
    };

    const showAnnounce = (message: string) => {
      announce.textContent = message;
    };

    const showSlash = () => slashInput.checked;

    const refreshCounters = () => {
      textCount.textContent = characterCountLabel(countCharacters(text.value));
      morseCount.textContent = signalCountLabel(countSignals(morse.value));
    };

    const refreshSecondary = () => {
      const hasMorse = morse.value.length > 0;
      if (puzzleButton instanceof HTMLButtonElement) puzzleButton.disabled = !hasMorse;
      if (exportButton instanceof HTMLButtonElement) exportButton.disabled = !hasMorse;
    };

    const applyHide = (hidden: boolean) => {
      hideInput.checked = hidden;
      if (hidden) {
        text.setAttribute('aria-hidden', 'true');
        text.setAttribute('inert', '');
        text.tabIndex = -1;
        text.classList.add('opacity-0');
        textMask.hidden = false;
        textMask.classList.remove('hidden');
        textMask.classList.add('flex');
      } else {
        text.removeAttribute('aria-hidden');
        text.removeAttribute('inert');
        text.removeAttribute('tabindex');
        text.classList.remove('opacity-0');
        textMask.hidden = true;
        textMask.classList.add('hidden');
        textMask.classList.remove('flex');
      }
    };

    const clearHighlight = () => {
      text.classList.remove('is-highlighting');
      morse.classList.remove('is-highlighting');
      if (textMirror instanceof HTMLElement) textMirror.textContent = '';
      if (morseMirror instanceof HTMLElement) morseMirror.textContent = '';
      if (lamp instanceof HTMLElement) {
        lamp.dataset.lit = 'false';
        lamp.style.backgroundColor = '#2a2f38';
      }
    };

    const syncMirrorsScroll = () => {
      if (textMirror instanceof HTMLElement) textMirror.scrollTop = text.scrollTop;
      if (morseMirror instanceof HTMLElement) morseMirror.scrollTop = morse.scrollTop;
    };

    const fromText = () => {
      if (lock) return;
      lock = true;
      lastSource = 'text';
      const result = encode(text.value, { wordSeparator: wordSeparatorFor(showSlash()) });
      morse.value = result.output;
      showNotice(unsupportedNotice(result.unsupported.length));
      lock = false;
      refreshCounters();
      refreshSecondary();
      clearHighlight();
    };

    const fromMorse = () => {
      if (lock) return;
      lock = true;
      lastSource = 'morse';
      const result = decode(morse.value);
      text.value = result.output;
      showNotice(unknownMorseNotice(result.unknown));
      lock = false;
      refreshCounters();
      refreshSecondary();
      clearHighlight();
    };

    const queueAutoplay = () => {
      if (!(autoplayInput instanceof HTMLInputElement) || !autoplayInput.checked || !allowAutoplay) return;
      if (!canAutoplayMorse(morse.value)) return;
      autoplay.schedule(() => {
        const ctx = openAudio();
        if (!ctx) {
          const status = document.getElementById('translator-audio-status');
          if (status) status.textContent = 'Press Play to start';
          return;
        }
        void loadPlayer().then((mod) => {
          mod.bindPlayerUi(playerUi);
          mod.startPlayback(ctx);
          refreshTransport();
        });
      });
    };

    const applyMode = (next: TranslatorMode, announceChange: boolean) => {
      const prev = mode;
      mode = next;
      const radio = root.querySelector<HTMLInputElement>(`input[data-mode][value="${next}"]`);
      if (radio) radio.checked = true;
      const leavingTap = prev === 'tap-input' && next !== 'tap-input';
      const leavingMic = prev === 'mic-listen' && next !== 'mic-listen';
      if (leavingTap || leavingMic) {
        // destroy() releases the mode's resources (mic tracks stop for mic-listen).
        (leavingTap ? tapHandle : micHandle)?.destroy();
        if (leavingTap) tapHandle = null;
        else micHandle = null;
        const mount = leavingTap ? tapMount : micMount;
        if (mount instanceof HTMLElement) {
          mount.hidden = true;
          mount.classList.add('hidden');
        }
        if (swapButton instanceof HTMLButtonElement) {
          swapButton.disabled = false;
          swapButton.removeAttribute('title');
        }
      }
      const isMic = next === 'mic-listen';
      if (isMic || next === 'tap-input') {
        if (swapButton instanceof HTMLButtonElement) {
          swapButton.disabled = true;
          swapButton.title = `Swap is not available in ${isMic ? 'Listen (mic)' : 'Tap input'}`;
        }
        const mount = isMic ? micMount : tapMount;
        if (mount instanceof HTMLElement) {
          mount.hidden = false;
          mount.classList.remove('hidden');
        }
        if (isMic) micLoading ??= import('../lib/mic-input');
        else tapLoading ??= import('../lib/tap-input');
        const shared = {
          text,
          morse,
          announce: showAnnounce,
          showSlash,
          onOutput: () => {
            lastSource = 'morse';
            refreshCounters();
            refreshSecondary();
            refreshAudio();
          },
          haltAudio,
        };
        void (isMic ? micLoading : tapLoading)!.then((mod) => {
          if (mode !== next || !(mount instanceof HTMLElement)) return;
          if (isMic) {
            micHandle?.destroy();
            micHandle = (mod as typeof import('../lib/mic-input')).mountMicMode({ root: mount, ...shared });
            micHandle.focusStart();
          } else {
            tapHandle?.destroy();
            tapHandle = (mod as typeof import('../lib/tap-input')).mountTapMode({
              root: mount,
              ...shared,
              vibrateEnabled: () => vibrationInput instanceof HTMLInputElement && vibrationInput.checked,
            });
            tapHandle.focusPad();
          }
        });
      } else if (next === 'morse-to-text') {
        if (panels.firstElementChild !== morsePanel) panels.insertBefore(morsePanel, textPanel);
        morse.focus();
      } else {
        if (panels.firstElementChild !== textPanel) panels.insertBefore(textPanel, morsePanel);
        text.focus();
      }
      if (announceChange) showAnnounce(modeAnnouncement(next));
    };

    const legacyCopy = (value: string) => {
      const area = document.createElement('textarea');
      area.value = value;
      area.style.cssText = 'position:fixed;left:-9999px';
      document.body.append(area);
      area.select();
      const ok = document.execCommand('copy');
      area.remove();
      return ok;
    };

    const flashCopy = (button: HTMLButtonElement & { copyTimer?: number }) => {
      const label = button.dataset.flash!;
      if (button.copyTimer) window.clearTimeout(button.copyTimer);
      const face = button.querySelector('[data-t]')!;
      const icon = button.querySelector('[data-i]')!;
      const original = button.dataset.label!;
      face.textContent = label;
      icon.classList.remove('hidden');
      button.dataset.state = 'copied';
      showAnnounce(label);
      button.copyTimer = window.setTimeout(() => {
        face.textContent = original;
        icon.classList.add('hidden');
        delete button.dataset.state;
        if (announce.textContent === label) showAnnounce('');
      }, 1500);
    };

    const copyValue = async (button: HTMLButtonElement, value: string, fieldId: string) => {
      const writeText = navigator.clipboard?.writeText?.bind(navigator.clipboard);
      if ((await copyWithFallback(value, writeText, legacyCopy)) === 'copied') {
        flashCopy(button);
        return 'copied' as const;
      }
      showNotice(root.dataset.copyError!);
      const field = document.getElementById(fieldId) as HTMLTextAreaElement | null;
      field?.focus();
      field?.select();
      return 'failed' as const;
    };

    const loadActions = () => {
      actionsLoading ??= import('../lib/translator-actions');
      return actionsLoading;
    };

    const playButton = document.querySelector('#translator-play');
    const playbar = root.querySelector('[data-playbar]');
    const playProgress = root.querySelector('[data-play-progress]');
    const playProgressFill = root.querySelector('[data-play-progress-fill]');
    const playTime = root.querySelector('[data-play-time]');
    const wavButton = document.querySelector('#translator-wav');
    const wpm = document.querySelector('#translator-wpm');
    const farnsworth = document.querySelector('#translator-farnsworth');
    const tone = document.querySelector('#translator-tone');
    const volume = document.querySelector('#translator-volume');
    const wpmValue = document.querySelector('#translator-wpm-value');
    const farnsworthValue = document.querySelector('#translator-farnsworth-value');
    const toneValue = document.querySelector('#translator-tone-value');
    const volumeValue = document.querySelector('#translator-volume-value');
    let loading: Promise<typeof import('../lib/morse-player')> | null = null;
    let audioToken = 0;
    let audioCtx: AudioContext | null = null;
    let speedNow = wpm instanceof HTMLInputElement ? Number(wpm.value) : 20;
    let spacingNow = farnsworth instanceof HTMLInputElement ? Number(farnsworth.value) : 20;
    let playbackState: 'idle' | 'playing' | 'paused' | 'finished' = 'idle';

    const formatPlayTime = (seconds: number) => {
      const whole = Math.max(0, Math.floor(seconds));
      const mins = Math.floor(whole / 60);
      const secs = whole % 60;
      return `${mins}:${secs.toString().padStart(2, '0')}`;
    };

    const setPlayProgress = (elapsed: number, total: number) => {
      const pct = total > 0 ? Math.min(100, Math.round((elapsed / total) * 100)) : 0;
      if (playProgressFill instanceof HTMLElement) playProgressFill.style.width = `${pct}%`;
      if (playProgress instanceof HTMLElement) playProgress.setAttribute('aria-valuenow', String(pct));
      if (playTime) {
        playTime.textContent = total > 0 ? `${formatPlayTime(elapsed)} / ${formatPlayTime(total)}` : '0:00';
      }
    };

    const loadPlayer = () => {
      loading ??= import('../lib/morse-player');
      return loading;
    };
    const prime = () => {
      void loadPlayer();
    };
    const openAudio = () => {
      if (!audioCtx) {
        const Ctx =
          window.AudioContext ??
          (window as Window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
        if (!Ctx) return null;
        audioCtx = new Ctx();
      }
      void audioCtx.resume();
      return audioCtx;
    };

    const refreshTransport = () => {
      const canPlay = /[.-]/.test(morse.value);
      const buttons = transportButtons(playbackState, canPlay);
      if (playButton instanceof HTMLButtonElement) {
        playButton.disabled = buttons.playDisabled;
        playButton.dataset.playing = playbackState === 'playing' ? 'true' : 'false';
      }
      if (playbar instanceof HTMLElement) {
        playbar.dataset.active = playbackState === 'playing' || playbackState === 'paused' ? 'true' : 'false';
      }
      if (pauseButton instanceof HTMLButtonElement) {
        pauseButton.disabled = buttons.pauseDisabled;
        pauseButton.textContent = buttons.pauseLabel;
      }
      if (stopButton instanceof HTMLButtonElement) stopButton.disabled = buttons.stopDisabled;
      if (wavButton instanceof HTMLButtonElement && !preparingWav) wavButton.disabled = buttons.wavDisabled;
    };

    const playerUi = {
      text,
      morse,
      textMirror: textMirror instanceof HTMLElement ? textMirror : null,
      morseMirror: morseMirror instanceof HTMLElement ? morseMirror : null,
      lamp: lamp instanceof HTMLElement ? lamp : null,
      setState(state: typeof playbackState) {
        playbackState = state;
        if (state === 'idle' || state === 'finished') {
          clearHighlight();
          if (state === 'idle') setPlayProgress(0, 0);
        }
        refreshTransport();
      },
      onFlash(on: boolean) {
        if (!(lamp instanceof HTMLElement)) return;
        lamp.dataset.lit = on ? 'true' : 'false';
        // Inline color so the lamp stays visible even if scoped CSS fails to match.
        lamp.style.backgroundColor = on ? '#f5c542' : '#2a2f38';
      },
      onProgress(elapsed: number, total: number) {
        setPlayProgress(elapsed, total);
      },
    };

    const updatePresetSelect = () => {
      if (!(presetSelect instanceof HTMLSelectElement)) return;
      presetSelect.value = matchPreset({ speed: speedNow, farnsworth: spacingNow });
    };

    const showSliders = () => {
      if (!(wpm instanceof HTMLInputElement) || !(farnsworth instanceof HTMLInputElement)) return;
      if (!(tone instanceof HTMLInputElement) || !(volume instanceof HTMLInputElement)) return;
      wpm.disabled = false;
      farnsworth.disabled = false;
      tone.disabled = false;
      volume.disabled = false;
      wpm.value = String(speedNow);
      farnsworth.value = String(spacingNow);
      if (wpmValue) wpmValue.textContent = String(speedNow);
      if (farnsworthValue) farnsworthValue.textContent = farnsworthLabel(speedNow, spacingNow);
      if (toneValue) toneValue.textContent = tone.value;
      if (volumeValue) volumeValue.textContent = volume.value;
      updatePresetSelect();
    };

    const refreshAudio = () => {
      refreshTransport();
    };

    const haltAudio = () => {
      audioToken += 1;
      autoplay.cancel();
      void loading?.then((mod) => mod.stopPlayback(false));
      playbackState = 'idle';
      clearHighlight();
      refreshTransport();
    };

    const syncWaveformEnabled = () => {
      const telegraph = soundTypeSelect instanceof HTMLSelectElement && soundTypeSelect.value === 'telegraph';
      if (waveformSelect instanceof HTMLSelectElement) waveformSelect.disabled = telegraph;
      if (waveformNote instanceof HTMLElement) waveformNote.classList.toggle('hidden', !telegraph);
    };

    const setupMotionAndVibrate = () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      const applyReduce = () => {
        if (!(flashInput instanceof HTMLInputElement)) return;
        if (reduce.matches) {
          flashInput.checked = false;
          flashInput.disabled = true;
          root.querySelector('[data-flash-warning]')?.classList.add('hidden');
          root.querySelector('[data-flash-reduced]')?.classList.remove('hidden');
        } else {
          flashInput.disabled = false;
          root.querySelector('[data-flash-warning]')?.classList.remove('hidden');
          root.querySelector('[data-flash-reduced]')?.classList.add('hidden');
        }
      };
      applyReduce();
      reduce.addEventListener('change', applyReduce);

      const supported = typeof navigator.vibrate === 'function';
      if (vibrationInput instanceof HTMLInputElement) {
        if (!supported) {
          vibrationInput.checked = false;
          vibrationInput.disabled = true;
          root.querySelector('[data-vibration-note]')?.classList.remove('hidden');
        }
      }
    };

    text.addEventListener('input', () => {
      haltAudio();
      allowAutoplay = true;
      fromText();
      refreshAudio();
      queueAutoplay();
    });
    morse.addEventListener('input', () => {
      haltAudio();
      allowAutoplay = true;
      fromMorse();
      refreshAudio();
      queueAutoplay();
    });
    text.addEventListener('scroll', syncMirrorsScroll);
    morse.addEventListener('scroll', syncMirrorsScroll);

    root.querySelectorAll<HTMLInputElement>('input[data-mode]').forEach((input) => {
      input.addEventListener('change', () => {
        if (!input.checked) return;
        applyMode(input.value as TranslatorMode, true);
      });
    });

    slashInput.addEventListener('change', () => {
      haltAudio();
      if (lastSource === 'morse') {
        morse.value = convertWordSeparators(morse.value, showSlash());
        refreshCounters();
        refreshSecondary();
      } else {
        fromText();
      }
      refreshAudio();
    });

    hideInput.addEventListener('change', () => {
      applyHide(hideInput.checked);
    });

    root.querySelector('[data-show-text]')?.addEventListener('click', () => {
      applyHide(false);
    });

    for (const button of [playButton, wavButton, pauseButton, stopButton, repeatButton]) {
      if (!(button instanceof HTMLButtonElement)) continue;
      button.addEventListener('pointerenter', prime);
      button.addEventListener('focus', prime);
    }

    playButton?.addEventListener('click', () => {
      allowAutoplay = false;
      autoplay.cancel();
      const ctx = openAudio();
      const token = ++audioToken;
      void loadPlayer().then((mod) => {
        if (token !== audioToken) return;
        mod.bindPlayerUi(playerUi);
        mod.startPlayback(ctx);
        refreshTransport();
      });
    });
    pauseButton?.addEventListener('click', () => {
      void loadPlayer().then((mod) => {
        if (playbackState === 'paused') mod.resumePlayback();
        else mod.pausePlayback();
        refreshTransport();
      });
    });
    stopButton?.addEventListener('click', () => {
      void loadPlayer().then((mod) => {
        mod.stopPlayback(true);
        playbackState = 'idle';
        clearHighlight();
        refreshTransport();
      });
    });
    repeatButton?.addEventListener('click', () => {
      if (!(repeatButton instanceof HTMLButtonElement)) return;
      const next = repeatButton.getAttribute('aria-pressed') !== 'true';
      repeatButton.setAttribute('aria-pressed', next ? 'true' : 'false');
    });

    wavButton?.addEventListener('click', () => {
      if (!(wavButton instanceof HTMLButtonElement) || preparingWav) return;
      const face = wavButton.querySelector('[data-face]');
      preparingWav = true;
      wavButton.disabled = true;
      if (face) face.textContent = wavButton.dataset.busy!;
      void loadPlayer().then((mod) => {
        mod.downloadCurrent();
        preparingWav = false;
        if (face) face.textContent = wavButton.dataset.label!;
        refreshAudio();
      });
    });

    wpm?.addEventListener('input', () => {
      if (!(wpm instanceof HTMLInputElement)) return;
      haltAudio();
      const next = changeSpeed({ speed: speedNow, farnsworth: spacingNow }, Number(wpm.value));
      speedNow = next.speed;
      spacingNow = next.farnsworth;
      showSliders();
    });
    farnsworth?.addEventListener('input', () => {
      if (!(farnsworth instanceof HTMLInputElement)) return;
      haltAudio();
      const next = changeFarnsworth({ speed: speedNow, farnsworth: spacingNow }, Number(farnsworth.value));
      spacingNow = next.farnsworth;
      showSliders();
    });
    for (const input of [tone, volume]) {
      input?.addEventListener('input', () => {
        haltAudio();
        showSliders();
      });
    }

    presetSelect?.addEventListener('change', () => {
      if (!(presetSelect instanceof HTMLSelectElement)) return;
      const id = presetSelect.value as PresetId;
      if (id === 'custom') return;
      haltAudio();
      const pair = applyPreset(id);
      speedNow = pair.speed;
      spacingNow = pair.farnsworth;
      showSliders();
    });
    soundTypeSelect?.addEventListener('change', () => {
      haltAudio();
      syncWaveformEnabled();
      void loadPlayer();
    });
    waveformSelect?.addEventListener('change', () => {
      haltAudio();
      void loadPlayer();
    });
    for (const input of [autoplayInput, flashInput, vibrationInput]) {
      input?.addEventListener('change', () => {
        void loadPlayer();
      });
    }

    setupMotionAndVibrate();
    syncWaveformEnabled();
    showSliders();
    refreshAudio();
    refreshCounters();
    refreshSecondary();

    root.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const control = target.closest('button');
      if (!(control instanceof HTMLButtonElement)) return;

      const copyId = control.dataset.copy;
      if (copyId) {
        const field = document.getElementById(copyId);
        if (field instanceof HTMLTextAreaElement) void copyValue(control, field.value, copyId);
        return;
      }
      if ('clear' in control.dataset) {
        haltAudio();
        if (mode === 'tap-input' && tapHandle) {
          tapHandle.clear();
        } else if (mode === 'mic-listen' && micHandle) {
          micHandle.clear();
        } else {
          text.value = '';
          morse.value = '';
        }
        lastSource = 'text';
        showAnnounce('');
        showNotice(control.dataset.announce!);
        refreshCounters();
        refreshSecondary();
        refreshAudio();
        if (mode === 'tap-input') tapHandle?.focusPad();
        else if (mode === 'mic-listen') micHandle?.focusStart();
        else (mode === 'morse-to-text' ? morse : text).focus();
        return;
      }
      if ('random' in control.dataset) {
        haltAudio();
        allowAutoplay = true;
        const phrase = pickRandomExample(() => Math.random(), lastExample);
        lastExample = phrase;
        text.value = phrase;
        fromText();
        showAnnounce(`Loaded example: ${phrase}`);
        refreshAudio();
        queueAutoplay();
        text.focus();
        return;
      }
      if ('swap' in control.dataset) {
        if (mode === 'tap-input' || mode === 'mic-listen') return;
        applyMode(swapMode(mode), true);
        return;
      }
      if ('shareCopy' in control.dataset || control.hasAttribute('data-share-copy')) {
        const url = buildShareUrl(location.href, text.value);
        void copyValue(control, url, 'translator-text');
        return;
      }
      if ('shareNative' in control.dataset || control.hasAttribute('data-share-native')) {
        const url = buildShareUrl(location.href, text.value);
        void loadActions().then(async (mod) => {
          const result = await mod.shareOrCopy(url, async (value) => copyWithFallback(value, navigator.clipboard?.writeText?.bind(navigator.clipboard), legacyCopy));
          if (result === 'copied') flashCopy(control);
          else if (result === 'failed') showNotice(root.dataset.copyError!);
        });
        return;
      }
      if ('puzzle' in control.dataset) {
        if (!morse.value) return;
        const url = buildPuzzleUrl(location.href, morse.value);
        void copyValue(control, url, 'translator-morse');
        return;
      }
      if ('exportTxt' in control.dataset || control.hasAttribute('data-export-txt')) {
        if (!morse.value) return;
        void loadActions().then((mod) => {
          const result = mod.downloadTxt(morse.value);
          showNotice(result.notice);
        });
      }
    });

    const payload = parseTranslatorHash(location.hash);
    if (payload) {
      if (payload.morse !== undefined) {
        morse.value = payload.morse;
        fromMorse();
        applyMode('morse-to-text', false);
        morse.focus();
      } else if (payload.text !== undefined) {
        text.value = payload.text;
        fromText();
      }
      if (payload.hide) applyHide(true);
      refreshAudio();
    }
  }
</script>
