---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import mark from '../assets/mark.png';
import { primaryNav } from '../config/nav';
import { SITE_NAME } from '../config/site';

const pathname = Astro.url.pathname;
const posts = await getCollection('blog', ({ data }) => !data.draft);
const links = posts.length > 0 ? [...primaryNav, { href: '/blog/', label: 'Blog' }] : [...primaryNav];
---

<header class="border-b border-line bg-surface">
  <div class="mx-auto flex min-h-11 w-full max-w-5xl flex-nowrap items-center gap-x-2 px-4 sm:gap-x-3">
    <a class="inline-flex min-h-11 shrink-0 items-center gap-2 font-semibold text-ink" href="/">
      <Picture
        src={mark}
        formats={['avif', 'webp']}
        alt=""
        width={32}
        height={32}
        densities={[1, 2]}
        loading="eager"
        decoding="async"
        fetchpriority="high"
        class="size-8 shrink-0"
      />
      {SITE_NAME}
    </a>
    <nav class="flex min-w-0 flex-1 flex-nowrap" aria-label="Primary">
      {
        links.map((link) => (
          <a
            class="inline-flex min-h-11 shrink-0 items-center px-2 text-sm text-ink sm:px-3"
            href={link.href}
            aria-current={pathname === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <button
      class="theme-toggle ml-auto size-11 shrink-0 items-center justify-center rounded-md text-ink"
      type="button"
      data-theme-toggle
      aria-pressed="false"
      aria-label="Toggle color theme"
    >
      <svg class="icon-sun size-5" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
        <path
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
        ></path>
      </svg>
      <svg class="icon-moon size-5" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linejoin="round"
          d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z"></path>
      </svg>
    </button>
  </div>
</header>
