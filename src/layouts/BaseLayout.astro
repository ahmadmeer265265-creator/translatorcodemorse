---
import { THEME_COLOR } from '../config/site';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import '../styles/global.css';

interface JsonLd {
  [key: string]: unknown;
}

interface Props {
  title: string;
  description: string;
  robots?: string;
  ogType?: 'website' | 'article';
  jsonLd?: JsonLd | JsonLd[];
  canonical?: boolean;
  suffix?: boolean;
}

const themeBoot = `(function(){var key="theme";var root=document.documentElement;var light=${JSON.stringify(THEME_COLOR.light)};var dark=${JSON.stringify(THEME_COLOR.dark)};root.classList.add("js");function system(){return window.matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light"}function stored(){try{var value=localStorage.getItem(key);return value==="light"||value==="dark"?value:null}catch(e){return null}}function apply(theme){root.setAttribute("data-theme",theme);var button=document.querySelector("[data-theme-toggle]");if(button){var isDark=theme==="dark";button.setAttribute("aria-pressed",isDark?"true":"false");button.setAttribute("aria-label",isDark?"Switch to light theme":"Switch to dark theme")}var color=theme==="dark"?dark:light;var metas=document.querySelectorAll('meta[name="theme-color"]');for(var i=0;i<metas.length;i++){metas[i].setAttribute("content",color)}}function current(){return stored()||system()}apply(current());window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change",function(){if(!stored())apply(system())});document.addEventListener("click",function(event){var node=event.target;var element=node&&node.nodeType===1?node:node&&node.parentElement;if(!element||!element.closest)return;if(!element.closest("[data-theme-toggle]"))return;var next=root.getAttribute("data-theme")==="dark"?"light":"dark";try{localStorage.setItem(key,next)}catch(e){}apply(next)});if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",function(){apply(current())})}})();`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeBoot}></script>
    <Seo {...Astro.props} />
    <meta name="theme-color" content={THEME_COLOR.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={THEME_COLOR.dark} media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link
      rel="icon"
      href="/favicon-16x16-dark.png"
      type="image/png"
      sizes="16x16"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      href="/favicon-32x32-dark.png"
      type="image/png"
      sizes="32x32"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  </head>
  <body class="flex min-h-dvh flex-col bg-canvas font-sans text-ink">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="mx-auto w-full max-w-5xl flex-1 px-4 pt-4 pb-12" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
