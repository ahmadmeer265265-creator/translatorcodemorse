---
import Breadcrumb from '../components/Breadcrumb.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { lastUpdatedIso } from '../config/pages';
import {
  absoluteUrl,
  AUTHOR_NAME,
  CONTACT_EMAIL,
  PUBLISHER_NAME,
  SITE_NAME,
} from '../config/site';
import { supportingJsonLd } from '../lib/schema';

const title = 'Terms of Use for the Morse Code Translator: No Warranty';
const description =
  'Terms of use for this free Morse code translator: no accounts, no warranty, and why you should not rely on it for emergencies or critical signals.';
const pageUrl = absoluteUrl('/terms/');
const lastUpdated = '28 November 2026';
const crumbs = [
  { name: 'Home', url: absoluteUrl('/') },
  { name: 'Terms of Use', url: pageUrl },
];
const jsonLd = supportingJsonLd({
  name: 'Terms of Use',
  description,
  url: pageUrl,
  crumbs,
  dateModified: lastUpdatedIso('/terms/'),
});

const link = 'text-accent underline underline-offset-4';
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  suffix={false}
  image="/og/terms.jpg"
  imageAlt="Terms of Use"
>
  <article class="grid max-w-3xl gap-8 text-[1.0625rem] leading-7">
    <Breadcrumb items={[{ href: '/', label: 'Home' }, { label: 'Terms of Use' }]} />
    <header class="grid gap-3">
      <h1 class="text-3xl font-semibold tracking-tight">Terms of Use</h1>
      <p class="text-sm text-muted">Last updated: {lastUpdated}</p>
    </header>

    <section class="grid gap-3">
      <h2 class="text-2xl font-semibold tracking-tight">Who we are</h2>
      <p>
        These terms apply to the website translatorcodemorse.com, called {SITE_NAME}, which is published by
        {PUBLISHER_NAME}. The founder is {AUTHOR_NAME}. Contact:
        <a class={link} href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>
    </section>

    <section class="grid gap-3">
      <h2 class="text-2xl font-semibold tracking-tight">What the site is</h2>
      <p>
        {SITE_NAME} is a free set of online tools and reference pages for Morse code. It includes a translator, an audio
        decoder, an image decoder, an American Morse translator, a Morse Code Machine for practice, and pages on the
        alphabet, numbers, SOS and sending speeds.
      </p>
    </section>

    <section class="grid gap-3">
      <h2 class="text-2xl font-semibold tracking-tight">Use of the tools</h2>
      <p>
        The tools are free to use. Do not rely on them in emergencies, for navigation or safety, or in any situation
        where a wrong result could cause harm. If you are in danger, contact local emergency services.
      </p>
    </section>

    <section class="grid gap-3">
      <h2 class="text-2xl font-semibold tracking-tight">Accuracy</h2>
      <p>
        We try to keep the charts and the tool results correct. If you find a mistake, please tell us at
        <a class={link} href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>
    </section>

    <section class="grid gap-3">
      <h2 class="text-2xl font-semibold tracking-tight">The Morse speed study</h2>
      <p>
        The aggregate dataset behind the speed statistics page is published on Zenodo (DOI 10.5281/zenodo.24540914) under
        the CC BY 4.0 license.
      </p>
    </section>
  </article>
</BaseLayout>
