---
import Breadcrumb from '../components/Breadcrumb.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { lastUpdatedIso } from '../config/pages';
import { absoluteUrl, AUTHOR_NAME, CONTACT_EMAIL, PUBLISHER_NAME } from '../config/site';
import { supportingJsonLd } from '../lib/schema';

const title = 'Contact the Morse Code Translator: Email Bugs and Fixes';
const description =
  'Email chart corrections, bug reports, and suggestions for this free Morse code translator. Use the address on this page; there is no contact form.';
const pageUrl = absoluteUrl('/contact/');
const crumbs = [
  { name: 'Home', url: absoluteUrl('/') },
  { name: 'Contact', url: pageUrl },
];
const jsonLd = supportingJsonLd({
  name: 'Contact',
  description,
  url: pageUrl,
  crumbs,
  dateModified: lastUpdatedIso('/contact/'),
});

const link = 'text-accent underline underline-offset-4';
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  suffix={false}
  image="/og/contact.jpg"
  imageAlt="Contact"
>
  <article class="grid max-w-3xl gap-8 text-[1.0625rem] leading-7">
    <Breadcrumb items={[{ href: '/', label: 'Home' }, { label: 'Contact' }]} />
    <header class="grid gap-3">
      <h1 class="text-3xl font-semibold tracking-tight">Contact</h1>
      <p>
        You can reach {PUBLISHER_NAME}, the publisher of this site, by email at
        <a class={link} href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. There is no contact form and no chat widget
        on this site, so email is the only way to reach us. Replies depend on available time.
      </p>
    </header>

    <section class="grid gap-3">
      <h2 class="text-2xl font-semibold tracking-tight">What to write to us about</h2>
      <ul class="list-disc space-y-2 pl-5">
        <li>A bug or a wrong result in a tool. Please tell us the page, your browser, your device and what you typed or did.</li>
        <li>A mistake in a chart or an explanation. Please tell us the page and the line.</li>
        <li>Ideas for new features.</li>
        <li>Questions about the Morse speed study or its dataset.</li>
        <li>Press or partnership questions.</li>
      </ul>
    </section>

    <section class="grid gap-3">
      <h2 class="text-2xl font-semibold tracking-tight">Please do not send</h2>
      <p>Please do not send passwords, personal documents or sensitive records. The tools do not need them.</p>
    </section>

    <section class="grid gap-3">
      <h2 class="text-2xl font-semibold tracking-tight">Who runs this site</h2>
      <p>This site is published by {PUBLISHER_NAME}. The founder is {AUTHOR_NAME}.</p>
    </section>
  </article>
</BaseLayout>
