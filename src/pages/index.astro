---
import HomeArticle from '../components/HomeArticle.astro';
import Translator from '../components/Translator.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeFaqs } from '../data/faq';
import { lastUpdatedIso } from '../config/pages';
import { absoluteUrl, LOGO_PATH, SITE_NAME } from '../config/site';

const title = 'Morse Code Translator: Free Online Converter & Audio';
const description =
  'Free private Morse code translator to convert or decode text online. Play sound, use tap and flash, download WAV—no sign-up, works in your browser.';
const pageUrl = absoluteUrl('/');
const dateModified = lastUpdatedIso('/');
const logoUrl = absoluteUrl(LOGO_PATH);

// FACEBOOK_URL / INSTAGRAM_URL in site.ts are still generic placeholders
// (facebook.com / instagram.com roots), not real profile pages — omit sameAs
// until real profile URLs are filled in.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: pageUrl,
  logo: logoUrl,
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: SITE_NAME,
    url: pageUrl,
    description,
    dateModified,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: pageUrl,
    description,
    publisher: {
      '@type': 'Organization',
      name: SITE_NAME,
      url: pageUrl,
      logo: logoUrl,
    },
  },
  organization,
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: SITE_NAME,
    url: pageUrl,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: homeFaqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <h1 class="text-center text-2xl font-semibold tracking-tight sm:text-3xl">Morse Code Translator</h1>
  <p class="mx-auto mt-1 max-w-2xl text-center text-sm text-muted sm:text-base">
    Translate text to Morse code and Morse code to text, then play it as sound or download a WAV file.
  </p>
  <p class="mx-auto mt-0.5 max-w-2xl text-center text-sm text-muted sm:text-base">
    Type in either panel. The other one updates as you go.
  </p>
  <div class="mt-2 sm:mt-4">
    <Translator />
  </div>

  <HomeArticle />
</BaseLayout>
