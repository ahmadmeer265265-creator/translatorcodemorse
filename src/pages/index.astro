---
import HomeArticle from '../components/HomeArticle.astro';
import Translator from '../components/Translator.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeFaqs } from '../data/faq';
import { lastUpdatedIso } from '../config/pages';
import { absoluteUrl, SITE_NAME } from '../config/site';

const title = 'Morse Code Translator: Text to Morse & Morse to Text';
const description =
  'Translate text to Morse code or Morse code to text in your browser, then play the sound or download a WAV file. Nothing you type is uploaded.';
const pageUrl = absoluteUrl('/');
const dateModified = lastUpdatedIso('/');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: SITE_NAME,
    url: pageUrl,
    description,
    dateModified,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: pageUrl,
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: SITE_NAME,
    url: pageUrl,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: homeFaqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <h1 class="text-3xl font-semibold tracking-tight">Morse Code Translator</h1>
  <p class="mt-2 max-w-2xl text-muted">
    Translate text to Morse code and Morse code to text, then play it as sound or download a WAV file.
  </p>
  <p class="mt-1 max-w-2xl text-muted">Type in either panel. The other one updates as you go.</p>
  <div class="mt-4">
    <Translator />
  </div>

  <HomeArticle />
</BaseLayout>
