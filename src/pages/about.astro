---
import Breadcrumb from '../components/Breadcrumb.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { lastUpdatedIso } from '../config/pages';
import {
  absoluteUrl,
  AUTHOR_JOB_TITLE,
  AUTHOR_NAME,
  CONTACT_EMAIL,
  PERSON_SAME_AS,
  PUBLISHER_NAME,
} from '../config/site';
import { organizationId, supportingJsonLd } from '../lib/schema';

const title = 'About the Morse Code Translator: Who Builds It and Why';
const description =
  'What this free Morse code translator is, what it does in your browser today, and who it is for. Text stays on your device; nothing you type is uploaded.';
const pageUrl = absoluteUrl('/about/');
const crumbs = [
  { name: 'Home', url: absoluteUrl('/') },
  { name: 'About', url: pageUrl },
];
const jsonLd = [
  ...supportingJsonLd({
    name: 'About',
    description,
    url: pageUrl,
    crumbs,
    dateModified: lastUpdatedIso('/about/'),
  }),
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: AUTHOR_NAME,
    jobTitle: AUTHOR_JOB_TITLE,
    worksFor: { '@id': organizationId() },
    sameAs: [...PERSON_SAME_AS],
  },
];

const link = 'text-accent underline underline-offset-4';
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  suffix={false}
  image="/og/about.jpg"
  imageAlt="About this Morse code translator"
>
  <article class="grid max-w-3xl gap-8 text-[1.0625rem] leading-7">
    <Breadcrumb items={[{ href: '/', label: 'Home' }, { label: 'About' }]} />
    <header class="grid gap-3">
      <h1 class="text-3xl font-semibold tracking-tight">About Morse Code Translator</h1>
      <p>
        Morse Code Translator is a free online tool that turns text into Morse code and Morse code back into text. It can
        play the Morse as sound, let you tap it out by hand, and read Morse from audio files and photos. The site is
        published by {PUBLISHER_NAME}.
      </p>
    </header>

    <section class="grid gap-3">
      <h2 class="text-2xl font-semibold tracking-tight">Who makes this site</h2>
      <p>
        {PUBLISHER_NAME} is the studio behind this site. It builds free web tools, and Morse Code Translator is one of
        them. The founder is {AUTHOR_NAME}, who runs the site.
      </p>
    </section>

    <section class="grid gap-3">
      <h2 class="text-2xl font-semibold tracking-tight">What you can do here</h2>
      <ul class="list-disc space-y-2 pl-5">
        <li>
          Convert <a class={link} href="/">text to Morse code and Morse code to text</a> with the main translator.
        </li>
        <li>Play the result as sound, flash it, tap it by hand and download it as a WAV file.</li>
        <li>
          Decode Morse from an audio file with the <a class={link} href="/morse-code-audio-translator/">audio translator</a>.
        </li>
        <li>
          Decode Morse from a photo with the <a class={link} href="/morse-code-image-translator/">image translator</a>.
        </li>
        <li>
          Try the <a class={link} href="/american-morse-code-translator/">American Morse code translator</a>, which differs
          from international Morse in a few letters.
        </li>
        <li>
          Practice sending and receiving on the <a class={link} href="/morse-code-machine/">Morse Code Machine</a>.
        </li>
        <li>
          Look up the <a class={link} href="/morse-code-alphabet/">alphabet</a>, the
          <a class={link} href="/morse-code-numbers/">numbers</a> and
          <a class={link} href="/sos-in-morse-code/">SOS</a> on their own pages.
        </li>
      </ul>
    </section>

    <section class="grid gap-3">
      <h2 class="text-2xl font-semibold tracking-tight">How the site treats your data</h2>
      <p>
        The translator works in your browser. The text you type and the audio or images you choose are processed on your
        device and are not uploaded to this site. The <a class={link} href="/privacy/">privacy page</a> explains what is
        stored on your device and what the hosting provider logs.
      </p>
    </section>

    <section class="grid gap-3">
      <h2 class="text-2xl font-semibold tracking-tight">The Morse speed study</h2>
      <p>
        {PUBLISHER_NAME} also published a study of how fast people send Morse code on the air. It uses public Reverse
        Beacon Network data. The aggregate dataset is on Zenodo with the DOI 10.5281/zenodo.24540914 under the CC BY 4.0
        license. You can read the results on the
        <a class={link} href="/morse-code-speed-statistics/">Morse code speed statistics</a> page.
      </p>
    </section>

    <section class="grid gap-3">
      <h2 class="text-2xl font-semibold tracking-tight">Corrections and feedback</h2>
      <p>
        If you find a wrong letter in a chart, a bug in a tool or a sentence that is unclear, please email
        <a class={link} href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. Please tell us the page, your browser and
        your device. Replies depend on available time.
      </p>
    </section>

    <section class="grid gap-3">
      <h2 class="text-2xl font-semibold tracking-tight">Contact</h2>
      <p>
        {PUBLISHER_NAME}. Founder: {AUTHOR_NAME}. Email:
        <a class={link} href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>
    </section>
  </article>
</BaseLayout>
